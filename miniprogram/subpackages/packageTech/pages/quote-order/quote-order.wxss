/* 完成服务页面 - X/Twitter 风格设计 */

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #f7f9fc 0%, #ffffff 100%);
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 
              0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 48rpx;
  transition: all 0.3s ease;
}

.card:active {
  transform: scale(0.995);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
  color: #0f1419;
  letter-spacing: 0.5rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #536471;
  margin-bottom: 16rpx;
  display: block;
}

/* --- 修改核心区域开始 --- */

/* 1. 提取公共基础样式 */
.input,
.textarea {
  width: 100%;
  border-radius: 16rpx;
  border: 2rpx solid #eff3f4;
  background: #f7f9fa;
  font-size: 30rpx;
  color: #0f1419;
  box-sizing: border-box; /* 关键属性 */
  transition: all 0.25s ease;
}

/* 2. 针对单行输入框的修复：固定高度，取消垂直padding */
.input {
  height: 96rpx;       /* 设定具体高度 */
  line-height: 96rpx;  /* 行高与高度一致，实现垂直居中 */
  padding: 0 28rpx;    /* 上下内边距设为0，避免挤压文字 */
}

/* 3. 针对多行文本域：保留垂直padding */
.textarea {
  padding: 24rpx 28rpx;
  min-height: 200rpx;
  line-height: 1.6;
}

/* --- 修改核心区域结束 --- */

.input:focus,
.textarea:focus {
  border-color: #1d9bf0;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(29, 155, 240, 0.1);
}

.input::placeholder,
.textarea::placeholder {
  color: #8b98a5;
}

/* 提交按钮 - X/Twitter 风格 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1d9bf0 0%, #0c7abf 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(29, 155, 240, 0.3),
              0 8rpx 24rpx rgba(29, 155, 240, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(29, 155, 240, 0.25),
              0 4rpx 16rpx rgba(29, 155, 240, 0.1);
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #cbd5e0 0%, #a0aec0 100%);
  color: #ffffff;
  opacity: 0.6;
  box-shadow: none;
  transform: none;
}

.submit-btn[loading] {
  opacity: 0.8;
}