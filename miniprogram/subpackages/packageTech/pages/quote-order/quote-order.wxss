.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f7f8fa;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  color: #333333;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e5e5;
  background: #f9f9f9;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
  box-sizing: border-box;
}

.submit-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #3c7bff, #255bff);
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  background: #d1d6e0;
  color: #ffffff;
}
