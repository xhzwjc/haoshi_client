<view class="page-ratings">
  
  <view class="rating-summary-card">
    <view class="left-score">
      <view class="score-value">{{summary.averageScore}}</view>
      <view class="score-label">综合评分</view>
      <view class="star-rating">
        <text class="star" wx:for="{{5}}" wx:key="index">★</text>
      </view>
    </view>
    
    <view class="right-stats">
      <view class="stat-item">
        <text class="label">好评率</text>
        <text class="value primary">{{summary.goodRatingRate}}%</text>
      </view>
      <view class="stat-item">
        <text class="label">累计评价</text>
        <text class="value">{{summary.totalRatings}}</text>
      </view>
      <view class="stat-item">
        <text class="label">近30天好评</text>
        <text class="value">{{summary.recentGoodRatings}}</text>
      </view>
    </view>
  </view>

  <view class="rating-tabs-container">
    <view class="rating-tabs">
      <view 
        class="tab-item {{activeTab === item.type ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="type"
        bindtap="onTabClick"
        data-type="{{item.type}}"
      >
        {{item.name}} ({{item.count}})
      </view>
    </view>
  </view>

  <view class="rating-list">
    <view class="loading-state" wx:if="{{loading}}">
        <text>正在加载评价...</text>
    </view>
    
    <block wx:elif="{{ratings.length > 0}}">
      <view class="rating-item" wx:for="{{ratings}}" wx:key="id">
        <view class="item-header">
          <image class="avatar" src="{{item.avatar}}"></image>
          <view class="user-info">
            <text class="nickname">{{item.nickname}}</text>
            <view class="stars-time">
               <text class="star-filled" wx:for="{{item.score}}" wx:key="index">★</text>
               <text class="star-empty" wx:for="{{5-item.score}}" wx:key="index">★</text>
               <text class="time">{{item.time}}</text>
            </view>
          </view>
        </view>
        <view class="content">{{item.content}}</view>
        <view class="service-info">
           <text>服务：{{item.serviceName}}</text>
           <text class="order-no">订单号: {{item.orderId}}</text>
        </view>
        <view class="reply-box" wx:if="{{item.reply}}">
           <text class="reply-label">我的回复：</text>
           <text class="reply-content">{{item.reply}}</text>
        </view>
        <button class="reply-btn" wx:elif="{{!item.reply && activeTab === 'all'}}" bindtap="replyRating" data-id="{{item.id}}">回复</button>
      </view>
    </block>
    
    <view class="empty-state" wx:else>
      <text>当前分类暂无评价</text>
    </view>
  </view>
</view>