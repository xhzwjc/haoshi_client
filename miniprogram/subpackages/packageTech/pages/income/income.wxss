/* pages/income/income.wxss */
page { background-color: #F7F8FA; }
.page-income { padding-bottom: 40rpx; }

/* 1. 收入概览卡片 */
.income-summary-card {
  background: linear-gradient(135deg, #1E88E5 0%, #42A5F5 100%); /* Blue gradient */
  color: #fff;
  padding: 40rpx 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 15rpx rgba(30, 136, 229, 0.3);
}
.title {
  font-size: 26rpx;
  opacity: 0.8;
}
.total-income {
  font-size: 68rpx;
  font-weight: bold;
  margin: 10rpx 0 40rpx 0;
}
.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}
.stat-item {
  flex: 1;
}
.stat-item .value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.stat-item .label {
  font-size: 24rpx;
  opacity: 0.8;
}
.divider {
  width: 1rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin: 0 30rpx;
  flex-shrink: 0;
}

/* 2. 明细筛选与操作 */
.section-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}
.month-selector {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.month-selector .arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}
.withdraw-btn {
  background-color: #4CAF50;
  color: #fff;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
}
.withdraw-btn image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 3. 交易明细列表 */
.detail-list {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-item:last-child { border-bottom: none; }
.detail-item .left { }
.detail-item .desc { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.detail-item .time { font-size: 24rpx; color: #999; }
.detail-item .right { text-align: right; }
.detail-item .amount { font-size: 30rpx; font-weight: bold; margin-bottom: 4rpx; }
.detail-item .amount.income { color: #4CAF50; }
.detail-item .amount.expense { color: #FF5722; }
.detail-item .status { font-size: 24rpx; color: #999; }

.empty-state, .loading-state { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx 0; }