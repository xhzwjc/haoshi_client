/* pages/index/index.wxss */
page { background-color: #F7F8FA; }
.page-index { padding-bottom: 60rpx; }

/* 1. Custom Header */
.header-bg {
  background: linear-gradient(180deg, #4CAF50 0%, #8BC34A 100%); /* Green gradient */
  color: #fff;
  padding: 0 32rpx 120rpx 32rpx; /* Bottom padding creates space for overlap */
  position: relative;
}
.title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.title-text-button {
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 26rpx;
  line-height: 1.2;
}
.title-text {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
}
.title-icon-button {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.title-icon {
  width: 35rpx;
  height: 35rpx;
  filter: invert(1);
}
.title-actions-spacer {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.technician-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
}
.info-left .name-rating {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.info-left .name { font-size: 40rpx; font-weight: bold; margin-right: 16rpx; }
.info-left .badge { background: #FFC107; color: #333; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; font-weight: bold; }
.info-left .rating-served { font-size: 26rpx; opacity: 0.9; }
.info-left .rating { margin-right: 10rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%;}
.header-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
  text-align: center;
}
.header-stats .stat-item .value { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.header-stats .stat-item .label { font-size: 24rpx; opacity: 0.8; }

/* Content Area */
.content-area {
  margin-top: -100rpx; /* Overlap with header */
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
}

/* Card Base Style */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

/* 2. Notification Card */
.notification-card {
  display: flex;
  align-items: center;
  background-color: #FFF7E6; /* Light orange background */
  border: 1rpx solid #FFE4BA;
}
.noti-icon { width: 48rpx; height: 48rpx; margin-right: 20rpx; flex-shrink: 0; }
.noti-text { flex-grow: 1; }
.noti-text .title { font-size: 28rpx; color: #D97706; font-weight: bold; margin-bottom: 4rpx; }
.noti-text .desc { font-size: 24rpx; color: #EA580C; }
.noti-btn {
  background-color: #333;
  color: #fff;
  font-size: 24rpx;
  padding: 0 18rpx; /* 收窄按钮宽度 */
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 28rpx;
  margin: 0;
  flex-shrink: 0;
  min-width: 220rpx;
  width: 160rpx !important;
}

/* Section Title */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 28rpx 0 20rpx 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.quick-title { margin-top: 24rpx; }

/* 3. Quick Functions */
.quick-functions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.func-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Align items to start */
  position: relative; /* For badge positioning */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.func-item image { width: 56rpx; height: 56rpx; margin-bottom: 16rpx; }
.func-item text { font-size: 30rpx; font-weight: bold; }
.func-item .sub-label { font-size: 24rpx; color: #999; margin-top: 8rpx; font-weight: normal; }
.badge-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background-color: #FA5151;
  color: #fff;
  font-size: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* 4. Service Stats */
.service-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.service-stats .stat-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #f9fbff 100%);
  box-shadow: 0 6rpx 18rpx rgba(60, 123, 255, 0.08);
  min-height: 150rpx;
}

.service-stats .stat-item.pending {
  background: linear-gradient(135deg, #eef4ff 0%, #f6f8ff 100%);
  box-shadow: 0 6rpx 18rpx rgba(37, 91, 255, 0.12);
}

.service-stats .stat-item.completed {
  background: linear-gradient(135deg, #e9fff3 0%, #f7fff9 100%);
  box-shadow: 0 6rpx 18rpx rgba(16, 185, 129, 0.12);
}

.service-stats .stat-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 16rpx;
}

.service-stats .stat-item .value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
  color: #1f2d3d;
}

.service-stats .stat-item .label {
  font-size: 24rpx;
  color: #5c6b7a;
}

/* 5. Recent Orders */
.recent-title .view-all {
  font-size: 26rpx;
  color: #999;
  display: flex;
  align-items: center;
  font-weight: normal;
}
.recent-title .arrow-icon { width: 24rpx; height: 24rpx; margin-left: 8rpx; }

.order-card-mini { /* Slightly different style from main order list */
  padding: 24rpx; /* Less padding */
}
.order-card-mini .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.order-card-mini .service-name { font-size: 28rpx; font-weight: bold; }
/* 对齐订单页状态标签风格 */
.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background-color: #f2f2f2;
}
.status-tag.status-10 { color: #409EFF; background-color: #ECF5FF; }
.status-tag.status-20 { color: #07C160; background-color: #F0FFF8; }
.status-tag.status-30 { color: #FA5151; background-color: #FFF1F0; }
.status-tag.status-35 { color: #ED6A0C; background-color: #FFFBE8; }
.status-tag.status-40 { color: #FF5722; background-color: #FFF0EB; }
.status-tag.status-50 { color: #409EFF; background-color: #ECF5FF; }
.status-tag.status-60 { color: #999; background-color: #F7F8FA; }
.status-tag.status-0 { color: #999; background-color: #F7F8FA; }
.status-tag.status--1 { color: #999; background-color: #F7F8FA; }
.order-card-mini .order-time, .order-card-mini .order-address {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.order-card-mini .icon { width: 28rpx; height: 28rpx; margin-right: 12rpx; opacity: 0.7; }
.order-card-mini .order-address .text-ellipsis {
    max-width: 500rpx; /* Limit address width */
}
.order-card-mini .card-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-card-mini .payment-info { font-size: 26rpx; color: #666; display: flex; align-items: baseline; flex-shrink: 0; margin-right: 10rpx; }
.order-card-mini .payment-info .price { font-size: 30rpx; color: #FA5151; font-weight: bold; margin-left: 6rpx; }
.order-card-mini .card-actions { display: flex; gap: 8rpx; flex-wrap: wrap; justify-content: flex-end; }
/* 订单卡片按钮样式优化 */
.order-card-mini .btn { 
  font-size: 24rpx; 
  font-weight: 600;
  height: 60rpx; 
  padding: 0 16rpx; 
  border-radius: 30rpx; 
  margin: 0; 
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: all 0.25s ease;
}

.order-card-mini .btn::after { 
  border: none; 
}

.order-card-mini .btn-plain { 
  background: #ffffff; 
  border: 2rpx solid #e1e8ed; 
  color: #536471; 
}

.order-card-mini .btn-plain:active {
  background: #f7f9fa;
  transform: scale(0.96);
}

.order-card-mini .btn-dark { 
  background: linear-gradient(135deg, #0f1419 0%, #1c2938 100%); 
  color: #ffffff; 
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(15, 20, 25, 0.15);
}

.order-card-mini .btn-dark:active {
  transform: scale(0.96);
}
.empty-recent { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx 0; }
