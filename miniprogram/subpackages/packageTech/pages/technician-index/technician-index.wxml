<view class="page-index">
  <view class="header-bg">
    <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
    <view class="title-bar" style="height: {{titleBarHeight}}px;">
      <view class="title-text-button" bindtap="handleLogout">退出</view>
      <text class="title-text">师傅首页</text>
      <view class="title-actions-spacer"></view>
    </view>
    <view class="technician-info">
      <view class="info-left">
        <view class="name-rating">
          <text class="name">{{technicianInfo.name || '师傅'}}</text>
          <text class="badge">{{technicianInfo.badge || '金牌'}}</text>
        </view>
        <view class="rating-served">
          <text class="rating">★ {{technicianInfo.rating || '--'}}分</text>
          <text class="served">· 已服务{{technicianInfo.servedOrders || 0}}单</text>
        </view>
      </view>
      <image class="avatar" src="{{technicianInfo.avatar || '/images/icon_profile_white.png'}}"></image>
    </view>
    <view class="header-stats">
      <view class="stat-item">
        <view class="value">{{dashboardData.pendingCount || 0}}</view>
        <view class="label">待接单</view>
      </view>
      <view class="stat-item">
        <view class="value">{{dashboardData.runningCount || 0}}</view>
        <view class="label">进行中</view>
      </view>
      <view class="stat-item">
        <view class="value">¥{{dashboardData.monthIncome || '0'}}</view>
        <view class="label">本月收入</view>
      </view>
    </view>
  </view>

  <view class="content-area">
    <view class="card notification-card" wx:if="{{dashboardData.notification}}">
      <image class="noti-icon" src="/packageCommon/images/icon_notification_orange.png"></image>
      <view class="noti-text">
        <view class="title">{{dashboardData.notification.title || '您有0个新订单待处理'}}</view>
        <view class="desc">{{dashboardData.notification.desc || '请及时接单，避免订单流失'}}</view>
      </view>
      <button class="noti-btn" bindtap="goToTaskCenter">查看</button>
    </view>

    <view class="section-title quick-title">快捷功能</view>
    <view class="quick-functions">
      <view class="func-item" bindtap="goToTaskCenter">
        <image src="/packageCommon/images/icon_task_blue.png"></image>
        <text>任务中心</text>
        <view class="badge-dot" wx:if="{{dashboardData.pendingCount > 0}}">{{dashboardData.pendingCount}}</view>
        <text class="sub-label">接单管理</text>
      </view>
      <view class="func-item" bindtap="goToSchedule">
        <image src="/packageCommon/images/icon_schedule_purple.png"></image>
        <text>我的排班</text>
         <text class="sub-label">时间管理</text>
      </view>
      <view class="func-item" bindtap="goToIncome">
        <image src="/packageCommon/images/icon_income_green.png"></image>
        <text>收入明细</text>
        <text class="sub-label">¥{{dashboardData.monthIncome || '0.00'}}</text>
      </view>
      <view class="func-item" bindtap="goToRatings">
        <image src="/packageCommon/images/icon_rating_yellow.png"></image>
        <text>我的评价</text>
         <text class="sub-label">{{technicianInfo.rating || '--'}}分</text>
      </view>
    </view>

    <view class="section-title">服务数据</view>
    <view class="card service-stats">
      <view class="stat-item pending">
        <image src="/packageCommon/images/icon_time_blue.png"></image>
        <view class="value">{{dashboardData.totalPendingService || 0}}</view>
        <view class="label">待服务订单</view>
      </view>
      <view class="stat-item completed">
        <image src="/packageCommon/images/icon_check_green.png"></image>
        <view class="value">{{dashboardData.totalCompleted || 0}}</view>
        <view class="label">已完成订单</view>
      </view>
    </view>

    <view class="section-title recent-title">
      <text>最近订单</text>
      <view class="view-all" bindtap="goToTaskCenter">
        查看全部
      </view>
    </view>
    <view class="recent-orders" wx:if="{{dashboardData.recentOrders && dashboardData.recentOrders.length > 0}}">
       <view class="card order-card-mini" wx:for="{{dashboardData.recentOrders}}" wx:key="_id">
         <view class="card-header">
           <view class="service-name">{{item.service_name}}</view>
           <view class="status-tag status-{{item.status}}">{{item.status_text}}</view>
         </view>
         <view class="order-time">
           <image class="icon" src="/packageCommon/images/icon_time_gray.png"></image>
           <text>{{item.service_time_display || '今天 14:00'}}</text>
         </view>
         <view class="order-address">
           <image class="icon" src="/packageCommon/images/icon_location_gray.png"></image>
           <text class="text-ellipsis">{{item.address}}</text>
         </view>
         <view class="card-footer">
           <view class="payment-info">
             <text wx:if="{{item.status < 35}}">报价:</text>
             <text wx:else>实付:</text>
             <text class="price">
               <text wx:if="{{item.status >= 35}}"></text>{{item.price_display || item.final_price || item.price_range || '待核价'}}
             </text>
           </view>
           <view class="card-actions">
             <button class="btn btn-plain" bindtap="viewOrderDetail" data-order="{{item}}" data-id="{{item._id}}">查看</button>
             <button class="btn btn-dark" wx:if="{{item.status === 10}}" bindtap="acceptOrderPrompt" data-order="{{item}}" data-id="{{item._id}}">接单</button>
           </view>
         </view>
       </view>
    </view>
    <view class="empty-recent" wx:else>暂无最近订单</view>

  </view> <order-detail-modal 
      wx:if="{{showDetailModal}}" 
      order="{{modalOrderDetail}}"
      bind:close="hideOrderDetailModal"
      bind:accept="acceptOrderFromModal"
      bind:reject="rejectOrderFromModal">
  </order-detail-modal>
  
</view>