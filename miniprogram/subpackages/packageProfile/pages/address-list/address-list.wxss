page {
  background: #f7f9fc;
  min-height: 100vh;
  color: #1f2933;
}

.address-page {
  padding: 40rpx 32rpx 120rpx;
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(74, 108, 240, 0.12), rgba(74, 108, 240, 0.04));
  border: 1rpx solid rgba(74, 108, 240, 0.16);
  margin-bottom: 40rpx;
  box-shadow: 0 30rpx 80rpx rgba(74, 108, 240, 0.1);
}

.hero-meta {
  max-width: 70%;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2933;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.6);
}

.add-btn {
  background: #4a6cf0;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(74, 108, 240, 0.28);
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.address-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(74, 108, 240, 0.08);
  box-shadow: 0 24rpx 60rpx rgba(31, 41, 61, 0.08);
  transition: border 0.2s ease, box-shadow 0.2s ease;
}

.address-card.default {
  border-color: rgba(74, 108, 240, 0.45);
  box-shadow: 0 30rpx 80rpx rgba(74, 108, 240, 0.16);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(74, 108, 240, 0.12);
  color: rgba(74, 108, 240, 0.85);
  font-size: 22rpx;
}

.tag.primary {
  background: rgba(74, 108, 240, 0.16);
  color: #4a6cf0;
}

.card-actions {
  display: flex;
  gap: 24rpx;
  color: rgba(31, 41, 51, 0.65);
  font-size: 24rpx;
}

.card-actions .action {
  padding: 8rpx 0;
}

.card-actions .action.danger {
  color: #f56c6c;
}

.card-body .line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #1f2933;
}

.card-body .line.address {
  margin-top: 12rpx;
  line-height: 1.6;
  color: rgba(31, 41, 51, 0.7);
}

.name {
  font-weight: 600;
}

.phone {
  color: rgba(31, 41, 51, 0.55);
}

.card-footer {
  margin-top: 28rpx;
}

.ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(74, 108, 240, 0.24);
  color: #4a6cf0;
  background: #f5f7ff;
}

.default-text {
  color: rgba(31, 41, 51, 0.55);
  font-size: 24rpx;
}

.empty-state {
  margin-top: 120rpx;
  text-align: center;
  color: rgba(31, 41, 51, 0.55);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.editor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.35);
  z-index: 100;
}

.editor-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 36rpx 32rpx 48rpx;
  z-index: 101;
  box-shadow: 0 -20rpx 40rpx rgba(15, 23, 42, 0.18);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  color: #1f2933;
  margin-bottom: 24rpx;
}

.panel-header .close {
  font-size: 44rpx;
  padding: 0 12rpx;
  color: rgba(31, 41, 51, 0.4);
}

.panel-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field.switch {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.65);
}

.input,
.textarea {
  background: #f3f6fd;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #1f2933;
  font-size: 28rpx;
  border: 1rpx solid rgba(74, 108, 240, 0.18);
}

.textarea {
  min-height: 160rpx;
}

.ph {
  color: rgba(74, 108, 240, 0.55);
}

.panel-footer {
  margin-top: 36rpx;
}

.submit-btn {
  width: 100%;
  background: #4a6cf0;
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 20rpx 50rpx rgba(74, 108, 240, 0.25);
}

.submit-btn:active,
.add-btn:active,
.ghost-btn:active {
  opacity: 0.88;
}

/* 全屏遮罩 */
.ios-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;

  background: rgba(255, 255, 255, 0.6);

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.ios-loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #d1d1d6;
  border-top-color: #007aff; 
  border-radius: 50%;
  animation: ios-spin 0.7s linear infinite;
}

@keyframes ios-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* 文案 */
.ios-loading-text {
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
}
