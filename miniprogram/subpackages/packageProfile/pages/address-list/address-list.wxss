page {
  background: #0f1419;
  min-height: 100vh;
  color: #ffffff;
}

.address-page {
  padding: 40rpx 32rpx 120rpx;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(29, 155, 240, 0.15), rgba(136, 153, 166, 0.05));
  border: 1rpx solid rgba(136, 153, 166, 0.2);
  margin-bottom: 40rpx;
}

.hero-meta {
  max-width: 70%;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #e7ecf0;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(231, 236, 240, 0.7);
}

.add-btn {
  background: #1d9bf0;
  color: #0f1419;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
  border: none;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.address-card {
  background: rgba(22, 24, 28, 0.85);
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(47, 51, 54, 0.8);
  box-shadow: 0 12rpx 32rpx rgba(15, 20, 25, 0.3);
}

.address-card.default {
  border-color: #1d9bf0;
  box-shadow: 0 12rpx 40rpx rgba(29, 155, 240, 0.25);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(136, 153, 166, 0.2);
  color: #8899a6;
  font-size: 22rpx;
}

.tag.primary {
  background: rgba(29, 155, 240, 0.18);
  color: #1d9bf0;
}

.card-actions {
  display: flex;
  gap: 24rpx;
  color: rgba(231, 236, 240, 0.8);
  font-size: 24rpx;
}

.card-actions .action {
  padding: 8rpx 0;
}

.card-actions .action.danger {
  color: #f4212e;
}

.card-body .line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #e7ecf0;
}

.card-body .line.address {
  margin-top: 12rpx;
  line-height: 1.6;
  color: rgba(231, 236, 240, 0.85);
}

.name {
  font-weight: 600;
}

.phone {
  color: rgba(231, 236, 240, 0.7);
}

.card-footer {
  margin-top: 28rpx;
}

.ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(136, 153, 166, 0.5);
  color: rgba(231, 236, 240, 0.85);
  background: transparent;
}

.default-text {
  color: rgba(231, 236, 240, 0.5);
  font-size: 24rpx;
}

.empty-state {
  margin-top: 120rpx;
  text-align: center;
  color: rgba(231, 236, 240, 0.6);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.editor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 20, 25, 0.7);
  z-index: 100;
}

.editor-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #16181c;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx 48rpx;
  z-index: 101;
  box-shadow: 0 -12rpx 24rpx rgba(15, 20, 25, 0.5);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  color: #e7ecf0;
  margin-bottom: 24rpx;
}

.panel-header .close {
  font-size: 44rpx;
  padding: 0 12rpx;
  color: rgba(136, 153, 166, 0.9);
}

.panel-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field.switch {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: rgba(231, 236, 240, 0.6);
}

.input,
.textarea {
  background: rgba(29, 32, 35, 0.9);
  border-radius: 20rpx;
  padding: 24rpx;
  color: #e7ecf0;
  font-size: 28rpx;
  border: 1rpx solid rgba(136, 153, 166, 0.2);
}

.textarea {
  min-height: 160rpx;
}

.ph {
  color: rgba(136, 153, 166, 0.6);
}

.panel-footer {
  margin-top: 36rpx;
}

.submit-btn {
  width: 100%;
  background: #1d9bf0;
  color: #0f1419;
  border: none;
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
