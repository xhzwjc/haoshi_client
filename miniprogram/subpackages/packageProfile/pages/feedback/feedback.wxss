page {
  background: #f5f7fb;
}

.page-feedback {
  padding: 32rpx 24rpx 120rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 35, 95, 0.05);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #5c6b7a;
  margin-bottom: 20rpx;
}

.picker-value,
.textarea,
.input {
  font-size: 28rpx;
  color: #1f2d3d;
}

.picker-value {
  padding: 24rpx 0;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.6;
}

.counter {
  text-align: right;
  font-size: 24rpx;
  color: #8a97a6;
  margin-top: 12rpx;
}

.input {
  padding: 12rpx 0;
}

.submit-btn {
  background: linear-gradient(135deg, #3a7afe 0%, #5a9bff 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  margin: 24rpx 8rpx 0;
}

.submit-btn::after {
  display: none;
}
