page {
  background: #f5f7fb;
}

.page-personal-info {
  padding: 32rpx 24rpx 120rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(20, 37, 63, 0.05);
  margin-bottom: 32rpx;
}

.avatar-card {
  display: flex;
  flex-direction: column;
}

.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 30rpx;
  color: #1f2d3d;
  font-weight: 600;
}

.avatar-action {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-action .avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f3f8;
  object-fit: cover;
}

.avatar-text {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  color: #1f2d3d;
}

.avatar-text .hint {
  font-size: 22rpx;
  color: #8a97a6;
  margin-top: 4rpx;
}

.form-card .form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef2f8;
}

.form-card .form-item .picker-field {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.form-card .form-item:last-child {
  border-bottom: none;
}

.input,
.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1f2d3d;
}

.picker-value {
  width: 100%;
}

.input {
  background: transparent;
}

.textarea-item {
  align-items: flex-start;
}

.textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1f2d3d;
  text-align: right;
  line-height: 1.6;
  padding-right: 8rpx;
}

.textarea-ph {
  color: #b6c0ce;
  text-align: right;
}

.tips {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #6b7a8c;
  margin: 24rpx 8rpx 48rpx;
}

.tips image {
  width: 36rpx;
  height: 36rpx;
}

.save-btn {
  background: linear-gradient(135deg, #3a7afe 0%, #5a9bff 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  height: 96rpx;
  line-height: normal;
  margin: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn::after {
  display: none;
}
