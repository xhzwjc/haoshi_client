.after-sale-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.page-heading {
  margin-bottom: 28rpx;
}

.heading-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 8rpx;
}

.heading-sub {
  font-size: 26rpx;
  color: #8e8e93;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.reason-item text {
  margin-left: 16rpx;
}

.description {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.phone-input {
  width: 100%;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.order-brief {
  background: linear-gradient(135deg, #f5f7ff 0%, #f0f7ff 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 36rpx;
  color: #3a3a3c;
}

.brief-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.brief-line {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #3773ff 0%, #2b5dff 100%);
  color: #ffffff;
  font-size: 32rpx;
  box-shadow: 0 18rpx 28rpx rgba(45, 90, 255, 0.25);
  line-height: 88rpx;
  display: block;
  text-align: center;
  padding: 0;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
