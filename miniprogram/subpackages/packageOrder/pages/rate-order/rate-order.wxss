.rate-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1d1d1f;
}

.order-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2a2a2e;
  margin-bottom: 12rpx;
}

.order-info {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.stars {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.star {
  font-size: 48rpx;
  color: #d7d7d7;
}

.star.active {
  color: #ffb400;
}

.score-label {
  font-size: 28rpx;
  color: #ffb400;
}

.comment {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff9b43 0%, #ff7d2a 100%);
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 18rpx 28rpx rgba(255, 140, 66, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.6;
}
