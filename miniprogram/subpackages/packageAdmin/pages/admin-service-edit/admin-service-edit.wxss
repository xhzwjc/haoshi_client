/* Service Edit Page Styles */
.page-service-edit {
  background-color: #F7F8FA;
  min-height: 100vh;
  padding: 20rpx;
}

.header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item.required .label::before {
  content: '* ';
  color: #FA5151;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input,
.textarea,
.picker-view {
  width: 100%;
  min-height: 80rpx;
  line-height: 1.6;
  padding: 20rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 200rpx;
}

.form-actions {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
