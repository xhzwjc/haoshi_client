/* 全局基础 */
page {
  background-color: #F2F2F7; /* iOS 分组背景色 */
  --system-blue: #007AFF;
  --system-gray: #8E8E93;
  --card-bg: #FFFFFF;
  --text-primary: #000000;
  --separator: #C6C6C8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  overflow: hidden;
}

/* === 1. 导航栏 === */
.ios-nav {
  position: fixed; top: 0; left: 0; width: 100%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  z-index: 999; border-bottom: 0.5px solid rgba(0,0,0,0.1);
}
.nav-content {
  height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px;
}
.nav-left { display: flex; align-items: center; height: 100%; width: 80px; }
.back-icon {
  width: 12px; height: 12px; border-left: 2px solid var(--system-blue); border-bottom: 2px solid var(--system-blue);
  transform: rotate(45deg); margin-right: 4px; margin-top: 1px;
}
.back-text { font-size: 17px; color: var(--system-blue); font-weight: 400; }
.nav-title { font-size: 17px; font-weight: 600; color: var(--text-primary); }
.nav-right { width: 80px; }

/* === 2. 内容区 === */
.page-content { width: 100%; height: 100vh; box-sizing: border-box; }

/* === 3. 分组表单 (Inset Grouped) === */
.ios-group-list {
  margin: 0 16px 24px 16px; /* 两侧留白 */
}
.group-header {
  font-size: 13px; color: var(--system-gray); text-transform: uppercase;
  margin-bottom: 8px; margin-left: 16px; /* header 缩进 */
}

/* 单元格容器 */
.list-cell {
  background-color: var(--card-bg);
  padding: 12px 16px;
  display: flex; align-items: center; justify-content: space-between;
  position: relative;
}
/* 圆角处理：第一个圆角，最后一个圆角 */
.ios-group-list .list-cell:first-of-type { border-top-left-radius: 10px; border-top-right-radius: 10px; }
.ios-group-list .list-cell:last-of-type { border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }

/* 链接型单元格点击态 */
.link-cell:active { background-color: #E5E5EA; }

.cell-label { font-size: 17px; color: var(--text-primary); width: 90px; flex-shrink: 0; }

.cell-input {
  flex: 1; font-size: 17px; color: var(--system-blue); /* 输入内容用蓝色突出 */
  text-align: right; height: 24px; min-height: 24px;
}

.cell-value { flex: 1; font-size: 17px; color: var(--system-blue); text-align: right; }
.cell-value.placeholder { color: #C7C7CC; }

.arrow { color: #C7C7CC; font-size: 14px; font-weight: 600; margin-left: 8px; font-family: monospace; }

/* 分割线：只有中间有 */
.divider { height: 0.5px; background-color: var(--separator); margin-left: 16px; background-color: #FFFFFF; }
.divider::after {
  content: ''; display: block; height: 0.5px; background-color: var(--separator);
}

/* 多行文本区域 */
.textarea-cell { display: block; height: auto; }
.cell-textarea {
  width: 100%; height: 120px; font-size: 16px; line-height: 1.5; color: var(--text-primary);
  margin-top: 4px;
}
.ph-style { color: #C7C7CC; }

/* === 4. 底部按钮 === */
.footer-action {
  position: fixed; bottom: 0; left: 0; right: 0;
  background-color: rgba(255,255,255,0.9);
  border-top: 0.5px solid var(--separator);
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  backdrop-filter: blur(10px);
}
.save-btn {
  background-color: var(--system-blue);
  color: #FFFFFF; font-size: 17px; font-weight: 600;
  line-height: 40px; border-radius: 12px;
  border: none;
}
.save-btn:active { opacity: 0.8; }
.save-btn[disabled] { background-color: #8E8E93; opacity: 0.5; }