/* 全局基础 */
page {
  background-color: #F2F2F7; /* iOS 分组背景色 */
  --system-blue: #007AFF;
  --system-gray: #8E8E93;
  --system-separator: #C6C6C8;
  --card-bg: #FFFFFF;
  --text-primary: #000000;
  --text-secondary: #3C3C4399; /* 60% 黑 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  overflow: hidden;
}

/* === 1. 导航栏 (复用 Dashboard 风格) === */
.ios-nav {
  position: fixed;
  top: 0; left: 0; width: 100%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 999;
  border-bottom: 0.5px solid rgba(0,0,0,0.1);
}
.nav-content {
  height: 44px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 16px;
}
.nav-left {
  display: flex; align-items: center; height: 100%; width: 80px; /* 增大点击热区 */
}
/* CSS 绘制 iOS 返回箭头 */
.back-icon {
  width: 12px; height: 12px;
  border-left: 2px solid var(--system-blue);
  border-bottom: 2px solid var(--system-blue);
  transform: rotate(45deg);
  margin-right: 4px;
  margin-top: 1px;
}
.back-text { font-size: 17px; color: var(--system-blue); font-weight: 400; }
.nav-title { font-size: 17px; font-weight: 600; color: var(--text-primary); }
.nav-right { width: 80px; }

/* === 2. 页面容器 === */
.page-content {
  width: 100%; height: 100vh;
  box-sizing: border-box;
}

/* === 3. iOS 分段控制器 (Tabs) === */
.segmented-control-container {
  padding: 10px 16px 20px 16px;
}
.ios-segmented-control {
  background-color: rgba(118, 118, 128, 0.12); /* iOS Control 背景灰 */
  border-radius: 9px;
  padding: 2px;
  display: flex;
  height: 32px;
}
.segment-item {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 500;
  border-radius: 7px;
  color: var(--text-primary);
  transition: all 0.2s ease;
}
.segment-item.active {
  background-color: #FFFFFF;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12), 0 3px 1px rgba(0, 0, 0, 0.04);
  font-weight: 600;
}

/* === 4. iOS 列表组 (Inset Grouped) === */
.ios-list-group {
  margin: 0 16px 24px 16px;
  background-color: var(--card-bg);
  border-radius: 12px;
  overflow: hidden; /* 裁剪圆角 */
  box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.list-cell {
  display: flex; align-items: center;
  padding-left: 16px; /* 左侧留白给分割线对齐 */
  background-color: #fff;
  height: 72px; /* 固定高度，更整齐 */
}
.list-cell:active { background-color: #E5E5EA; } /* 点击态 */

/* 列表分割线：只有中间有，最后一项没有 */
.cell-content {
  flex: 1;
  display: flex; align-items: center; justify-content: space-between;
  height: 100%;
  padding-right: 16px;
  border-bottom: 0.5px solid var(--system-separator);
}
.list-cell:last-child .cell-content {
  border-bottom: none;
}

/* 图标 */
.cell-icon {
  width: 40px; height: 40px;
  border-radius: 20px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  margin-right: 12px;
  flex-shrink: 0;
}
.blue-bg { background: #EBF3FF; }
.orange-bg { background: #FFF4E5; }

/* 文字内容 */
.cell-main {
  display: flex; flex-direction: column; justify-content: center;
}
.cell-title {
  font-size: 17px; font-weight: 500; color: var(--text-primary);
  margin-bottom: 2px;
}
.cell-sub {
  font-size: 13px; color: var(--system-gray);
}

.cell-right {
  display: flex; align-items: center;
}
.cell-detail {
  font-size: 15px; color: var(--system-gray);
}

/* === 状态胶囊 === */
.status-capsule {
  font-size: 12px; font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
}
.status-ACTIVE { background: rgba(52, 199, 89, 0.15); color: #34C759; } /* iOS Green */
.status-PENDING { background: rgba(255, 149, 0, 0.15); color: #FF9500; } /* iOS Orange */
.status-DISABLED { background: rgba(255, 59, 48, 0.15); color: #FF3B30; } /* iOS Red */

/* Loading & Empty */
.loading-state { padding: 40px 0; display: flex; justify-content: center; }
.spinner {
  width: 24px; height: 24px;
  border: 3px solid #E5E5E5; border-top-color: var(--system-gray);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.empty-state {
  text-align: center; padding-top: 60px; color: var(--system-gray); font-size: 15px;
}