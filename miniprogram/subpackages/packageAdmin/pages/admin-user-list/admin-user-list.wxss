page {
  background: #f5f7fb;
}

.user-list-page {
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.tab {
  flex: 1;
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(31, 41, 51, 0.6);
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.tab.active {
  color: #4a6cf0;
  border-bottom-color: #4a6cf0;
  font-weight: 600;
}

.content {
  padding: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}

.item-phone {
  font-size: 24rpx;
  color: rgba(31, 41, 51, 0.6);
}

.item-meta,
.item-orders {
  font-size: 24rpx;
  color: rgba(31, 41, 51, 0.6);
}

.item-status {
  flex-shrink: 0;
}

.status-badge {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-ACTIVE {
  background: rgba(67, 233, 123, 0.2);
  color: #38c172;
}

.status-PENDING {
  background: rgba(255, 179, 0, 0.2);
  color: #f59e0b;
}

.status-DISABLED {
  background: rgba(245, 95, 108, 0.2);
  color: #f56565;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: rgba(31, 41, 51, 0.5);
}
