/* Admin User List Page */
.user-list-page {
  background-color: #F7F8FA;
  min-height: 100vh;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #E5E5E5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #667eea;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* Content */
.content {
  padding: 20rpx;
}

/* Loading State - Center of screen */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #E5E5E5;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-state text {
  font-size: 28rpx;
  color: #999;
}

/* List */
.list {
  background: #fff;
}

.list-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.item-phone {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.item-meta {
  font-size: 24rpx;
  color: #999;
}

.item-status {
  flex-shrink: 0;
}

.status-badge {
  padding: 0 20rpx;
  height: 52rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 112rpx;
  background-color: #fff7e6;
}

.status-text {
  font-size: 26rpx;
  line-height: 1;
  position: relative;
  top: -12rpx;     /* ↑ 只移动文字，不动背景 */
}





.status-badge.status-ACTIVE {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-badge.status-PENDING {
  background: #FFF3E0;
  color: #FF9800;
}

.status-badge.status-DISABLED {
  background: #FFEBEE;
  color: #F44336;
}

/* Empty State */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
