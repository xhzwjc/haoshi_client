.page-container {
  padding: 32rpx;
  padding-bottom: 120rpx;
  background-color: #F7F8FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
  padding-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999999;
}

.notice-input {
  width: 100%;
  min-height: 160rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  border: 2rpx solid #E8E8E8;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.banner-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.banner-item {
  position: relative;
  width: 200rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.banner-img {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-bottom-left-radius: 12rpx;
}

.add-btn {
  width: 200rpx;
  height: 120rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D0D0D0;
  color: #666666;
  transition: all 0.3s ease;
}

.add-btn:active {
  background: #F0F0F0;
  border-color: #409EFF;
}

.add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  line-height: 1;
  color: #409EFF;
}

.add-btn text {
  font-size: 24rpx;
  color: #666666;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.save-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-weight: 600;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.save-btn.button-hover {
  opacity: 0.9;
}
