/* 全局基础 */
page {
  background-color: #F2F2F7;
  --system-blue: #007AFF;
  --system-red: #FF3B30;
  --system-green: #34C759;
  --system-gray: #8E8E93;
  --system-orange: #FF9500;
  --card-bg: #FFFFFF;
  --text-primary: #000000;
  --separator: #3C3C432E; 
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  overflow: hidden;
}

/* === 1. 导航栏 === */
.ios-nav {
  position: fixed; top: 0; left: 0; width: 100%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  z-index: 999; border-bottom: 0.5px solid rgba(0,0,0,0.1);
}
.nav-content {
  height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px;
}
.nav-left { display: flex; align-items: center; height: 100%; width: 60px; }
.back-icon {
  width: 12px; height: 12px; border-left: 2px solid var(--system-blue); border-bottom: 2px solid var(--system-blue);
  transform: rotate(45deg); margin-right: 4px; margin-top: 1px;
}
.back-text { font-size: 17px; color: var(--system-blue); font-weight: 400; }
.nav-title { font-size: 17px; font-weight: 600; color: var(--text-primary); }
.nav-right { width: 60px; }

/* === 2. 页面容器 === */
.page-content { width: 100%; height: 100vh; box-sizing: border-box; }

/* === 3. 分段控制器 (Tabs) === */
.segmented-control-container { padding: 10px 16px 20px 16px; }
.ios-segmented-control {
  background-color: rgba(118, 118, 128, 0.12); border-radius: 9px; padding: 2px;
  display: flex; height: 32px;
}
.segment-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 500; border-radius: 7px; color: var(--text-primary);
  transition: all 0.2s ease;
}
.segment-item.active {
  background-color: #FFFFFF; box-shadow: 0 3px 8px rgba(0,0,0,0.12); font-weight: 600;
}

/* === 4. 列表容器 === */
.ios-list-group {
  margin: 0 16px; display: flex; flex-direction: column; gap: 16px;
}

/* === 5. 人员卡片 === */
.tech-card {
  background-color: var(--card-bg); border-radius: 12px; overflow: hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}

.card-main {
  padding: 16px; display: flex; align-items: flex-start;
}

/* 头像区域 */
.avatar-wrap {
  width: 48px; height: 48px; border-radius: 24px;
  background: #EBF3FF; color: var(--system-blue);
  display: flex; align-items: center; justify-content: center;
  margin-right: 16px; flex-shrink: 0;
  font-weight: 600; font-size: 20px;
}

.info-content { flex: 1; }

.info-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;
}
.tech-name { font-size: 17px; font-weight: 600; color: var(--text-primary); }

.status-badge { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; }
.status-ACTIVE { background: rgba(52, 199, 89, 0.15); color: var(--system-green); }
.status-PENDING { background: rgba(255, 149, 0, 0.15); color: var(--system-orange); }
.status-DISABLED { background: rgba(255, 59, 48, 0.15); color: var(--system-red); }

.info-row { font-size: 14px; color: var(--system-gray); margin-bottom: 4px; }
.info-row .value { color: #3C3C43; } /* 稍深一点的灰色 */

/* 底部操作栏 */
.card-actions {
  border-top: 0.5px solid var(--separator); display: flex; height: 44px;
}
.action-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
}
.action-item:active { background-color: #E5E5EA; }

.action-text { font-size: 15px; font-weight: 500; }
.action-text.blue { color: var(--system-blue); }
.action-text.red { color: var(--system-red); }
.action-text.green { color: var(--system-green); }

.vertical-line { width: 0.5px; height: 100%; background-color: var(--separator); }

/* Loading & Empty */
.loading-state { padding: 40px 0; display: flex; justify-content: center; }
.spinner {
  width: 24px; height: 24px; border: 3px solid #E5E5E5; border-top-color: var(--system-gray);
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 80px; }
.empty-text { color: var(--system-gray); font-size: 15px; }