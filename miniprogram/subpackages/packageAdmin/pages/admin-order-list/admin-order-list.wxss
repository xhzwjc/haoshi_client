page{background:#f5f7fb}.order-list-page{min-height:100vh}.filters{background:#fff;padding:24rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,.05)}.filter-scroll{white-space:nowrap}.filter-item{display:inline-block;padding:16rpx 32rpx;margin-right:16rpx;border-radius:16rpx;background:#f5f7fb;font-size:24rpx;color:rgba(31,41,51,.7)}.filter-item.active{background:#4a6cf0;color:#fff;font-weight:600}.content{padding:24rpx}.order-list{display:flex;flex-direction:column;gap:16rpx}.order-item{background:#fff;border-radius:16rpx;padding:32rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06)}.order-service{font-size:28rpx;font-weight:600;color:#1f2933;display:block;margin-bottom:8rpx}.order-price{font-size:32rpx;font-weight:700;color:#4a6cf0;display:block;margin-bottom:8rpx}.order-time{font-size:24rpx;color:rgba(31,41,51,.6);display:block}.empty{text-align:center;padding:120rpx 0;font-size:28rpx;color:rgba(31,41,51,.5)}
