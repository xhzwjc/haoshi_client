page {
  background: #f5f7fb;
}

.admin-dashboard {
  padding: 32rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2933;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(31, 41, 51, 0.6);
  display: block;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2933;
  display: block;
  margin-bottom: 24rpx;
}

/* Stats Section */
.stats-section {
  margin-bottom: 40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stat-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.stat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(31, 41, 51, 0.6);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2933;
}

/* Functions Section */
.functions-section {
  margin-bottom: 40rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.function-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.function-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.function-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.function-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}

.function-desc {
  font-size: 24rpx;
  color: rgba(31, 41, 51, 0.6);
  text-align: center;
}

/* Today Section */
.today-section {
  margin-bottom: 40rpx;
}

.today-grid {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.today-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
}

.today-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4a6cf0;
}

.today-label {
  font-size: 22rpx;
  color: rgba(31, 41, 51, 0.6);
}

/* 顶部导航栏 */
.admin-nav {
  height: 120rpx;
  padding-top: 40rpx; /* 状态栏适配 */
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* 左侧按钮区域 */
.nav-left {
  width: 160rpx; /* 这个宽度保证标题能在屏幕中心 */
  display: flex;
  justify-content: flex-start;
  padding-left: 20rpx;
}

/* 中央标题区域 */
.nav-center {
  flex: 1; 
  display: flex;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
}

/* 右侧留空区域，让标题真正居中 */
.nav-right {
  width: 160rpx; /* 和左边对称，保证视觉居中 */
}

/* 退出按钮样式 */
.nav-exit {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 10rpx 16rpx;
  border: 2rpx solid #ff4d4f;
  border-radius: 10rpx;
}
