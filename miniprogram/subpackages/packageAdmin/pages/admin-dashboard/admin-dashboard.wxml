<view class="ios-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <view class="nav-side"></view> 
    <view class="nav-title">管理员后台</view>
    <view class="nav-side"></view>
  </view>
</view>

<scroll-view class="page-content" scroll-y>
  
  <view class="nav-placeholder" style="height: {{statusBarHeight + 44 + 10}}px;"></view>

  <view class="large-title-area">
    <text class="large-title">概览</text>
    <text class="date-tag">{{todayDate}}</text>
  </view>

  <view class="hero-card">
    <view class="card-inner">
      <view class="card-header">
        <text class="card-label">累计总收入</text>
        <view class="icon-blur">¥</view>
      </view>
      <view class="card-main-value">
        <text class="currency">¥</text>
        <text class="amount">{{stats.totalRevenue || '0.00'}}</text>
      </view>
      <view class="card-footer">
        <text class="footer-text">今日营收 +{{todayStats.revenue}}</text>
        <view class="trend-tag">↗ +2.4%</view>
      </view>
    </view>
  </view>

  <view class="section-header">数据统计</view>
  <view class="widget-grid">
    <view class="widget-box">
      <view class="widget-icon blue-bg">📦</view>
      <text class="widget-val">{{stats.totalOrders}}</text>
      <text class="widget-label">总订单量</text>
      <text class="widget-sub">今日 +{{todayStats.newOrders}}</text>
    </view>
    
    <view class="widget-box">
      <view class="widget-icon purple-bg">👥</view>
      <text class="widget-val">{{stats.totalUsers}}</text>
      <text class="widget-label">总用户</text>
      <text class="widget-sub">今日 +{{todayStats.newUsers}}</text>
    </view>

    <view class="widget-box">
      <view class="widget-icon orange-bg">👷</view>
      <text class="widget-val">{{stats.totalTechs}}</text>
      <text class="widget-label">服务人员</text>
      <text class="widget-sub">审核中 0</text>
    </view>
  </view>

  <view class="section-header">管理工具</view>
  <view class="ios-menu-group">
    
    <view class="menu-item" bindtap="goToUserManagement">
      <view class="menu-icon-wrap blue-bg"><text>👥</text></view>
      <text class="menu-text">用户管理</text>
      <text class="arrow">></text>
    </view>
    <view class="divider"></view>

    <view class="menu-item" bindtap="goToOrderManagement">
      <view class="menu-icon-wrap purple-bg"><text>📝</text></view>
      <text class="menu-text">订单管理</text>
      <text class="arrow">></text>
    </view>
    <view class="divider"></view>

    <view class="menu-item" bindtap="goToServiceManagement">
      <view class="menu-icon-wrap green-bg"><text>🛠</text></view>
      <text class="menu-text">服务配置</text>
      <text class="arrow">></text>
    </view>
    <view class="divider"></view>

    <view class="menu-item" bindtap="goToPersonnelAudit">
      <view class="menu-icon-wrap yellow-bg"><text>🛡</text></view>
      <text class="menu-text">人员审核</text>
      <text class="arrow">></text>
    </view>
    <view class="divider"></view>

    <view class="menu-item" bindtap="goToHomeSettings">
      <view class="menu-icon-wrap pink-bg"><text>🖼</text></view>
      <text class="menu-text">首页装修</text>
      <text class="arrow">></text>
    </view>

  </view>

  <view class="logout-section">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
    <view class="version-info">Admin System v1.0.0</view>
  </view>

  <view style="height: calc(20px + env(safe-area-inset-bottom));"></view>
</scroll-view>