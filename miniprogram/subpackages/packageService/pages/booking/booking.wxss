/* subpackages/packageService/pages/booking/booking.wxss */
page {
  background-color: #F7F8FA;
}

/* 1. 顶部进度条 */
.progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #fff;
  padding: 32rpx 48rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #EBEDF0;
  color: #C8C9CC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.step-text {
  font-size: 26rpx;
}
.step-line {
  flex: 1;
  height: 4rpx;
  background-color: #EBEDF0;
  margin: 0 16rpx;
  position: relative;
  top: -20rpx;
}
.step.active .step-num {
  background-color: #409EFF;
  color: #fff;
}
.step.active .step-text {
  color: #409EFF;
  font-weight: bold;
}

/* 2. 服务信息卡片 */
.service-info-card {
  background-color: #fff;
  margin: 32rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.card-header {
  display: flex;
  justify-content: space-between; /* 确保标题左、价格右 */
  align-items: baseline; /* 对齐价格和标题的基线（更美观） */
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  /* 防止标题过长挤压价格，最多显示2行，超出省略 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 新增：价格容器样式（核心） */
.price-wrap {
  display: flex; /* 让 price 和 price-unit 同行显示 */
  align-items: baseline; /* 价格和单位垂直对齐（避免高低不一） */
  white-space: nowrap; /* 强制不换行 */
  text-align: right; /* 兜底右对齐 */
}
.price {
  font-size: 36rpx; /* 价格字体可稍大，突出显示 */
  font-weight: bold;
  color: #FA5151; /* 可选：价格标红 */
}
.price-unit {
  font-size: 24rpx; /* 单位字体比价格小，更协调 */
  color: #666;
  margin-left: 4rpx; /* 价格和单位之间留一点间距 */
}

.card-desc {
  font-size: 26rpx;
  color: #666;
}

/* 3. 填写表单 */
.address-toolbar {
  margin: 32rpx;
  display: flex;
  gap: 20rpx;
}

.tool-btn {
  flex: 1;
  border-radius: 999rpx;
  border: 1rpx solid #1677FF;
  color: #1677FF;
  background: rgba(22, 119, 255, 0.08);
  font-size: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  display: block;
  padding: 0;
}

.tool-btn.secondary {
  border-color: #B1B6BD;
  color: #5A6270;
  background: #fff;
}

.tool-btn::after {
  display: none;
}

.form-section {
  background-color: #fff;
  margin: 32rpx;
  border-radius: 16rpx;
  padding: 0 32rpx;
}
.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.form-item:last-child {
  border-bottom: none;
}
.form-item.remark {
  align-items: flex-start;
  padding: 32rpx 0;
}
.item-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  position: relative;
}
.item-label.required::before {
  content: '*';
  color: #FA5151;
  position: absolute;
  left: -16rpx;
  top: 4rpx;
}
.item-content {
  flex: 1;
  font-size: 28rpx;
}
.item-content input,
.item-content textarea {
  width: 100%;
  height: 100rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.item-content textarea {
  height: 160rpx;
  padding: 32rpx 0;
}
.ph { /* placeholder 样式 */
  color: #C8C9CC;
}
.item-content.location {
  display: flex;
  align-items: center;
}
.location-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}


/* 地址输入框样式 */
.location {
  position: relative;
  display: flex;
  align-items: center;
}

.location input {
  flex: 1;
  padding-right: 60rpx;
}

.location-icon {
  position: absolute;
  right: 0;
  line-height: 1.4;
}
/* 4. 提交按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}
.submit-btn {
  background-color: #1677FF;
  color: #fff;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 0;
}
.submit-btn:not([disabled]) {
  /* 假设表单有效时变色 */
  /* background-color: #409EFF; */
}