<view class="page-confirm">
    <!-- 顶部进度条 -->
    <view class="progress-bar">
        <view class="step completed">
            <view class="step-num">1</view>
            <view class="step-text">填写信息</view>
        </view>
        <view class="step-line completed"></view>
        <view class="step completed">
            <view class="step-num">2</view>
            <view class="step-text">选择时间</view>
        </view>
        <view class="step-line active"></view>
        <view class="step active">
            <view class="step-num">3</view>
            <view class="step-text">确认支付</view>
        </view>
    </view>

    <!-- 订单状态卡片 -->
    <view class="status-card">
        <view class="status-title">待支付</view>
        <view class="status-desc">请在 15 分钟内完成支付</view>
        <view class="total-price">
            <text class="currency">¥</text>{{orderSummary.total_price_display}}
        </view>
    </view>
    
    <!-- 服务详情卡片 -->
    <view class="info-card">
        <view class="card-title">服务详情</view>
        <view class="info-row">
            <text class="label">服务名称</text>
            <text class="value">{{orderSummary.service_name}}</text>
        </view>
        <view class="info-row">
            <text class="label">服务时间</text>
            <text class="value highlight">{{orderSummary.service_date}} {{orderSummary.service_time_slot}}</text>
        </view>
        <view class="info-row">
            <text class="label">服务地址</text>
            <text class="value">{{orderSummary.address}}</text>
        </view>
    </view>
    
    <!-- 联系人信息卡片 -->
    <view class="info-card">
        <view class="card-title">联系信息</view>
        <view class="info-row">
            <text class="label">联系人</text>
            <text class="value">{{orderSummary.contact_name}}</text>
        </view>
        <view class="info-row">
            <text class="label">联系电话</text>
            <text class="value">{{orderSummary.contact_phone}}</text>
        </view>
        <view class="info-row">
            <text class="label">备注信息</text>
            <text class="value">{{bookingData.remarks || '无'}}</text>
        </view>
    </view>
    
    <!-- 支付方式 -->
    <view class="info-card pay-card">
        <view class="card-title">支付方式</view>
        <view class="pay-method selected">
            <view class="method-left">
                <image class="icon" src="/packageCommon/images/icon_wechat_pay.png" mode="aspectFit"></image>
                <text>微信支付</text>
            </view>
            <image class="check-icon" src="/packageCommon/images/icon_checked_blue.png" mode="aspectFit"></image>
        </view>
    </view>

    <!-- 底部支付栏 -->
    <view class="bottom-bar-safe">
        <view class="bottom-bar-content">
            <view class="price-container">
                <text class="label">合计:</text>
                <text class="currency">¥</text>
                <text class="amount">{{orderSummary.total_price_display}}</text>
            </view>
            <button class="pay-btn" bindtap="onConfirmPay">立即支付</button>
        </view>
    </view>
</view>