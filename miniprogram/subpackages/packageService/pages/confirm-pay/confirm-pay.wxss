/* /subpackages/packageService/pages/confirm-pay/confirm-pay.wxss */

/* === 页面基础样式 === */
.page-booking {
  /* 增加底部留白，适应双按钮布局 */
  padding-bottom: 180rpx; 
  background-color: #f7f7f7; 
  min-height: 100vh;
}

/* 顶部进度条 */
.progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #fff;
  padding: 32rpx 48rpx;
  margin-bottom: 20rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #EBEDF0;
  color: #C8C9CC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.step-text {
  font-size: 26rpx;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background-color: #EBEDF0;
  margin: 0 16rpx;
  position: relative;
  top: -20rpx;
}

.step-line.completed {
  background-color: rgba(64, 158, 255, 0.4);
}

.step-line.active {
  background: linear-gradient(90deg, rgba(64, 158, 255, 0.4) 0%, #409EFF 100%);
}

.step.completed .step-num {
  background-color: rgba(64, 158, 255, 0.25);
  color: #409EFF;
}

.step.completed .step-text {
  color: #409EFF;
}

.step.active .step-num {
  background-color: #409EFF;
  color: #fff;
}

.step.active .step-text {
  color: #409EFF;
  font-weight: bold;
}


/* === 通用卡片样式 === */
.section-card {
  background-color: #fff;
  margin: 0 30rpx 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 12rpx; 
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.03);
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1px solid #eee;
}

/* === 订单总览卡片 (total-summary) === */
.total-summary {
  text-align: center;
  padding: 40rpx 30rpx;
  margin-top: 20rpx;
}
.summary-header {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 15rpx;
}
.total-price-display {
  font-size: 72rpx; 
  font-weight: bold;
  color: #FF5722;
}
.total-price-display .unit {
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 5rpx;
}

/* === 详情列表 (detail-section) === */
.detail-section .info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f4f4f4; 
}
.detail-section .info-item:last-child {
  border-bottom: none;
}
.detail-section .label {
  color: #999;
  flex-shrink: 0;
  margin-right: 30rpx;
}
.detail-section .value {
  color: #333;
  text-align: right;
  word-break: break-all;
}
.detail-section .value.long-text {
  max-width: 70%; 
}

/* === 支付方式选择 (pay-method-section) === */
.pay-method-section {
  padding: 30rpx;
}
.pay-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1px solid #eee;
}
.pay-item:last-child {
  border-bottom: none;
}
.pay-item .pay-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
}
.pay-item .pay-name {
  font-size: 30rpx;
  color: #333;
  flex-grow: 1;
}
.pay-item .check-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.2; 
}
.pay-item.selected .check-icon {
  opacity: 1; 
}


/* === 【核心修改】底部操作栏 (双按钮) === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex; /* 启用 Flex 布局 */
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 5rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
  align-items: center;
  gap: 20rpx; /* 增加按钮间距 */
}
.bottom-bar button {
  height: 96rpx;
  font-size: 34rpx; /* 略微减小字号以适应双按钮 */
  border-radius: 12rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/* 确认支付按钮 */
.bottom-bar .confirm-btn.flex-grow {
  flex: 1; /* 占据剩余主要空间 */
  background-color: #FF5722; 
  color: #fff;
  font-weight: bold;
}

/* 返回/取消按钮 (新样式) */
.bottom-bar .btn-cancel {
  flex-basis: 35%; /* 给予取消按钮一定宽度 */
  background-color: #f0f0f0;
  color: #333;
  border: 1px solid #ddd;
}

