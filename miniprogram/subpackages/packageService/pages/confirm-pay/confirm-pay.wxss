/* /subpackages/packageService/pages/confirm-pay/confirm-pay.wxss */

/* === 基础布局 === */
.page-confirm {
  padding-bottom: 140rpx;
  background-color: #F7F8FA;
  min-height: 100vh;
}

/* === 进度条 (保持一致性) === */
.progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 60rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 10;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #F2F3F5;
  color: #C8C9CC;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: bold;
}
.step-text {
  font-size: 24rpx;
  color: #969799;
}

/* 激活/完成状态 */
.step.active .step-num,
.step.completed .step-num {
  background-color: #1677FF;
  color: #fff;
}
.step.active .step-text,
.step.completed .step-text {
  color: #323233;
  font-weight: bold;
}
.step-line {
  flex-grow: 1;
  height: 4rpx;
  background-color: #F2F3F5;
  margin: 0 20rpx 36rpx 20rpx;
  border-radius: 2rpx;
}
.step-line.active,
.step-line.completed {
  background-color: #1677FF;
}

/* === 状态卡片 === */
.status-card {
  background: linear-gradient(135deg, #1677FF 0%, #409EFF 100%);
  margin: 20rpx 30rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.2);
}
.status-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.status-desc {
  font-size: 26rpx;
  opacity: 0.8;
  margin-bottom: 30rpx;
}
.total-price {
  font-size: 60rpx;
  font-weight: bold;
}
.total-price .currency {
  font-size: 32rpx;
  margin-right: 4rpx;
}

/* === 通用信息卡片 === */
.info-card {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #1677FF;
  line-height: 1;
}
.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.info-row:last-child {
  margin-bottom: 0;
}
.info-row .label {
  color: #969799;
  flex-shrink: 0;
  margin-right: 30rpx;
}
.info-row .value {
  color: #323233;
  text-align: right;
  flex: 1;
}
.info-row .value.highlight {
  color: #1677FF;
  font-weight: bold;
}

/* === 支付方式 === */
.pay-method {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}
.method-left {
  display: flex;
  align-items: center;
}
.method-left .icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}
.method-left text {
  font-size: 30rpx;
  color: #323233;
}
.check-icon {
  width: 40rpx;
  height: 40rpx;
}

/* === 底部支付栏 === */
.bottom-bar-safe {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bottom-bar-content {
  height: 110rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  justify-content: space-between;
}
.price-container {
  display: flex;
  align-items: baseline;
}
.price-container .label {
  font-size: 28rpx;
  color: #323233;
  margin-right: 10rpx;
}
.price-container .currency {
  font-size: 28rpx;
  color: #FF5722;
  font-weight: bold;
}
.price-container .amount {
  font-size: 48rpx;
  color: #FF5722;
  font-weight: bold;
}

.pay-btn {
  margin: 0;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(90deg, #FF5722 0%, #FF8D1A 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(255, 87, 34, 0.3);
}

