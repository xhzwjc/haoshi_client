/* /subpackages/packageService/pages/confirm-pay/confirm-pay.wxss */

/* === 页面基础样式 === */
.page-booking {
  padding-bottom: 150rpx; /* 增加底部留白，适应单按钮 */
  background-color: #f7f7f7; 
  min-height: 100vh;
}

/* 移除原有的进度条样式 (不再需要) */
.progress-bar { display: none; }


/* === 通用卡片样式 === */
.section-card {
  background-color: #fff;
  margin: 0 30rpx 20rpx 30rpx; /* 左右增加边距，使卡片悬浮感更强 */
  padding: 30rpx;
  border-radius: 12rpx; 
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.03);
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1px solid #eee;
}

/* === 订单总览卡片 (total-summary) === */
.total-summary {
  text-align: center;
  padding: 40rpx 30rpx;
  margin-top: 20rpx; /* 顶部增加间隔 */
}
.summary-header {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 15rpx;
}
.total-price-display {
  font-size: 72rpx; 
  font-weight: bold;
  color: #FF5722;
}
.total-price-display .unit {
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 5rpx;
}

/* === 详情列表 (detail-section) === */
.detail-section .info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f4f4f4; 
}
.detail-section .info-item:last-child {
  border-bottom: none;
}
.detail-section .label {
  color: #999;
  flex-shrink: 0;
  margin-right: 30rpx;
}
.detail-section .value {
  color: #333;
  text-align: right;
  word-break: break-all;
}
.detail-section .value.long-text {
  max-width: 70%; 
}

/* === 支付方式选择 (pay-method-section) === */
.pay-method-section {
  padding: 30rpx;
}
.pay-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1px solid #eee;
}
.pay-item:last-child {
  border-bottom: none;
}
.pay-item .pay-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
}
.pay-item .pay-name {
  font-size: 30rpx;
  color: #333;
  flex-grow: 1;
}
.pay-item .check-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.2; 
}
.pay-item.selected .check-icon {
  opacity: 1; 
}


/* === 底部操作栏 (只保留确认支付) === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 5rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
}
.bottom-bar button {
  height: 96rpx; /* 增加高度 */
  line-height: 96rpx;
  font-size: 36rpx; /* 增加字号 */
  border-radius: 12rpx; 
  margin: 0;
  padding: 0;
}
/* 铺满宽度 */
.confirm-btn.full-width {
  flex: 1; /* 占据所有空间 */
  background-color: #FF5722; /* 使用醒目的橙色 */
  color: #fff;
  font-weight: bold;
}
/* 移除 prev-btn 样式 */
.prev-btn {
  display: none;
}


/* 帮助按钮 (如果不需要，请在 WXML 中移除) */
.help-btn {
  position: fixed;
  bottom: 150rpx; 
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  z-index: 999;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}