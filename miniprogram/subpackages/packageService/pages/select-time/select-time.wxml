<view class="page-booking">
    <!-- 顶部进度条 -->
    <view class="progress-bar">
        <view class="step finished">
            <view class="step-num">1</view>
            <view class="step-text">填写信息</view>
        </view>
        <view class="step-line active-line"></view>
        
        <view class="step active">
            <view class="step-num">2</view>
            <view class="step-text">选择时间</view>
        </view>
        <view class="step-line"></view>
        <view class="step">
            <view class="step-num">3</view>
            <view class="step-text">确认支付</view>
        </view>
    </view>

    <!-- 服务信息简略展示 -->
    <view class="service-header">
        <view class="service-name">{{service.name}}</view>
        <view class="service-price">
            <text class="currency">¥</text>{{service.price}}<text class="unit">/{{service.unit}}</text>
        </view>
    </view>

    <!-- 日期选择区域 (横向滚动) -->
    <view class="date-section">
        <view class="section-title">选择日期</view>
        <scroll-view class="date-scroll" scroll-x enable-flex>
            <view 
                class="date-card {{item.selected ? 'active' : ''}}" 
                wx:for="{{dateList}}" 
                wx:key="fullDate"
                data-date="{{item.fullDate}}"
                data-index="{{index}}"
                bindtap="onDateSelect"
            >
                <view class="week">{{item.week}}</view>
                <view class="day">{{item.month}}-{{item.day}}</view>
            </view>
        </scroll-view>
    </view>

    <!-- 时段选择区域 -->
    <view class="time-section">
        <view class="section-title">选择时段</view>
        <view class="time-grid">
            <view
                class="time-item {{item.time === selectedTime ? 'active' : ''}} {{!item.available ? 'disabled' : ''}}"
                wx:for="{{timeSlots}}"
                wx:key="time"
                data-time="{{item.time}}"
                bindtap="onTimeSlotSelect"
            >
                <view class="time-text">{{item.time}}</view>
                <view class="status-text">{{item.available ? (item.time === selectedTime ? '已选' : '可约') : '约满'}}</view>
            </view>
        </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar-safe">
        <view class="bottom-bar-content">
            <view class="selected-info" wx:if="{{selectedDate && selectedTime}}">
                <text>已选：{{selectedDate}} {{selectedTime}}</text>
            </view>
            <view class="selected-info placeholder" wx:else>
                <text>请选择服务时间</text>
            </view>
            
            <button class="next-btn {{selectedDate && selectedTime ? '' : 'disabled'}}" bindtap="onNextStep">
                下一步
            </button>
        </view>
    </view>
</view>