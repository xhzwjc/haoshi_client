/* /subpackages/packageService/pages/select-time/select-time.wxss */

/* === 基础布局 === */
.page-booking {
  padding-bottom: 140rpx; /* 底部安全区 */
  background-color: #F7F8FA;
  min-height: 100vh;
}

/* === 进度条 (保持原有风格但微调) === */
.progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 60rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 10;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #F2F3F5;
  color: #C8C9CC;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: bold;
}
.step-text {
  font-size: 24rpx;
  color: #969799;
}

/* 激活/完成状态 */
.step.active .step-num,
.step.finished .step-num {
  background-color: #1677FF;
  color: #fff;
}
.step.active .step-text {
  color: #323233;
  font-weight: bold;
}
.step.finished .step-text {
  color: #323233;
}

.step-line {
  flex-grow: 1;
  height: 4rpx;
  background-color: #F2F3F5;
  margin: 0 20rpx 36rpx 20rpx;
  border-radius: 2rpx;
}
.step-line.active-line {
  background-color: #1677FF;
}

/* === 服务简略信息 === */
.service-header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.service-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}
.service-price {
  color: #FF5722;
  font-size: 36rpx;
  font-weight: bold;
}
.service-price .currency {
  font-size: 24rpx;
  margin-right: 4rpx;
}
.service-price .unit {
  font-size: 24rpx;
  color: #969799;
  font-weight: normal;
  margin-left: 4rpx;
}

/* === 通用标题 === */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #1677FF;
  line-height: 1;
}

/* === 日期选择 (横向滚动) === */
.date-section {
  background-color: #fff;
  padding: 30rpx 0 30rpx 30rpx; /* 右侧不padding让滚动条通透 */
  margin-bottom: 20rpx;
}
.date-scroll {
  white-space: nowrap;
  display: flex;
  height: 140rpx;
}
.date-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  margin-right: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.date-card .week {
  font-size: 24rpx;
  color: #323233;
  margin-bottom: 8rpx;
}
.date-card .day {
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
}
/* 选中状态 */
.date-card.active {
  background-color: rgba(22, 119, 255, 0.1);
  border-color: #1677FF;
}
.date-card.active .week,
.date-card.active .day {
  color: #1677FF;
}

/* === 时段选择 (Grid布局) === */
.time-section {
  background-color: #fff;
  padding: 30rpx;
  min-height: 400rpx; /* 撑开高度 */
}
.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3列 */
  gap: 20rpx;
}
.time-item {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.time-item .time-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 6rpx;
}
.time-item .status-text {
  font-size: 22rpx;
  color: #969799;
}

/* 选中状态 */
.time-item.active {
  background-color: #1677FF;
  border-color: #1677FF;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
}
.time-item.active .time-text,
.time-item.active .status-text {
  color: #fff;
}

/* 禁用状态 */
.time-item.disabled {
  background-color: #fff;
  border: 2rpx solid #EBEDF0;
  opacity: 0.6;
}
.time-item.disabled .time-text {
  color: #C8C9CC;
  text-decoration: line-through;
}
.time-item.disabled .status-text {
  color: #C8C9CC;
}

/* === 底部操作栏 (悬浮) === */
.bottom-bar-safe {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bottom-bar-content {
  height: 110rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  justify-content: space-between;
}
.selected-info {
  display: flex;
  flex-direction: column;
}
.selected-info text {
  font-size: 28rpx;
  color: #323233;
  font-weight: bold;
}
.selected-info.placeholder text {
  color: #969799;
  font-weight: normal;
}

.next-btn {
  margin: 0;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(90deg, #1677FF 0%, #409EFF 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.3);
}
.next-btn.disabled {
  background: #EBEDF0;
  color: #C8C9CC;
  box-shadow: none;
}