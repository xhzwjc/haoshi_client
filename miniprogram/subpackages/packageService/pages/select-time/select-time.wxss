/* /subpackages/packageService/pages/select-time/select-time.wxss */

/* === 基础布局和进度条（沿用 booking 样式）=== */
.page-booking {
  padding-bottom: 120rpx; /* 留出底部按钮空间 */
}

/* 进度条样式 (假设与 booking 页面一致) */
.progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 60rpx;
  background-color: #fff;
  font-size: 26rpx;
  color: #999;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 10;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #eee;
  color: #fff;
  margin-bottom: 10rpx;
  font-size: 24rpx;
}
.step.active .step-num {
  background-color: #1677FF; /* 主题蓝色 */
}
.step.active .step-text {
  color: #333;
  font-weight: bold;
}

/* 修正点：支持 WXML 中的 class="step finished" */
.step.finished .step-num {
    background-color: #1677FF;
    font-size: 26rpx;
    font-weight: bold;
}
/* 确保已完成步骤的数字是白色 */
.step.finished .step-num {
    color: #fff;
}


.step-line {
  flex-grow: 1;
  height: 2rpx;
  background-color: #eee;
  margin: 0 -30rpx 30rpx -30rpx;
}
.step.active + .step-line,
/* 修正点：让已完成的步骤连接线也变蓝 (对应 WXML 中的 active-line) */
.step.finished + .step-line.active-line {
  background-color: #1677FF;
}

/* 第二步：完成第一步，激活第二步 (这段代码通常是重复或不必要的，但保留) */
.progress-bar .step:nth-child(1) .step-num {
  /* 移除这段，统一使用 .step.finished */
  /* background-color: #1677FF; */ 
}
.progress-bar .step:nth-child(1) + .step-line {
  /* 移除这段，统一使用 .step.finished + .active-line */
  /* background-color: #1677FF; */
}


/* === 服务信息卡片 (沿用 booking 样式) === */
.service-info-card {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-bottom: 1px solid #eee;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF5722;
}
.card-desc {
  font-size: 26rpx;
  color: #999;
}

/* === 表单部分 (选择日期/时段) === */
.form-section {
  background-color: #fff;
  padding: 0 30rpx;
}
.form-item {
  padding: 30rpx 0;
  border-bottom: 1px solid #eee;
}
.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

/* 日期选择器样式 */
.date-picker {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}
.date-picker .ph {
  color: #ccc;
}
.calendar-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: auto; /* 推到最右边 */
}

/* === 时段选择样式 (核心部分) === */
.time-slots-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx; /* 间距 */
  padding-top: 10rpx;
}
.time-slot-item {
  width: calc(50% - 10rpx); /* 实现两列布局 */
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f4f4f4;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}
.time-slot-item .clock-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

/* 选中状态 */
.time-slot-item.active {
  background-color: #1677FF; /* 主题色 */
  color: #fff;
}
.time-slot-item.active .clock-icon {
  /* 选中后可能需要将时钟图标变白，需要用CSS滤镜或替换图片 */
  filter: invert(100%); 
}

/* 禁用状态 */
.time-slot-item.disabled {
  background-color: #fcfcfc;
  color: #ccc;
  text-decoration: line-through;
  pointer-events: none; /* 禁用点击 */
}

/* === 底部操作栏 (沿用 booking 样式) === */
.bottom-bar.step-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 5rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}
.bottom-bar button {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 10rpx;
  margin: 0;
  padding: 0;
}
.prev-btn {
  flex: 1;
  background-color: #f4f4f4;
  color: #333;
  margin-right: 20rpx;
}
.next-btn {
  flex: 2;
  background-color: #1677FF;
  color: #fff;
}