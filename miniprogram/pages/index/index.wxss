/* pages/index/index.wxss */
@import "/app.wxss"; /* 引入全局样式 */

.page-index {
  padding-bottom: 120rpx; /* 留出tabbar空间 */
}

/* 1. 顶部Banner */
.banner-container {
  width: 100%;
  height: 300rpx; /* 增加高度 */
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.9; /* ✅ 可调整图片透明度，让文字清晰 */
}

.banner-content {
  position: relative;
  z-index: 1;
  padding-top: 40rpx;
  color: #fff;
}
.banner-title {
  font-size: 40rpx;
  font-weight: bold;
}
.banner-sub {
  font-size: 28rpx;
  margin-top: 16rpx;
  opacity: 0.9;
}

/* 2. 平台通知 */
.notification-bar,
.notice-bar {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  background-color: #FFFBE8;
  color: #ED6A0C;
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  margin: 0 32rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  position: relative;
  top: -40rpx; /* 关键：重叠在Banner上 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.noti-icon,
.notice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
}

.notice-text {
  line-height: 1.6;
}


/* 3. 家政服务 Grid */
.service-section {
  padding: 0 32rpx;
  margin-top: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 32rpx;
  padding: 32rpx 16rpx;
  box-sizing: border-box;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 0;
}
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.grid-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.grid-icon {
  width: 52rpx;
  height: 52rpx;
}
.grid-text {
  font-size: 26rpx;
  color: #333;
}

/* 4. 热门推荐 */
.recommend-section {
  background: #fff;
  border-radius: 16rpx;
  margin: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
}
.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}
.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

/* 服务卡片 */
.service-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.service-card:last-child {
  border-bottom: none;
}
.card-left {
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
/* 【新增/修复】热门标签样式 */
.card-title .hot-tag {
    font-size: 20rpx;
    color: #FA5151;
    border: 1rpx solid #FA5151;
    padding: 4rpx 8rpx;
    border-radius: 6rpx;
    margin-left: 16rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.card-footer {
  font-size: 24rpx;
  color: #999;
}
.rating-box { /* 补充评分盒子样式 */
    display: flex;
    align-items: center;
}
.rating-star { /* 补充星星样式 */
    color: #FFC000;
    margin-right: 8rpx;
}
.rating-text { /* 补充评分文本样式 */
    color: #333;
    font-weight: bold;
    margin-right: 20rpx;
}

/* 【修改】右侧容器：增加固定宽度和 flex-shrink: 0 保证按钮对齐 */
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 32rpx;
  width: 200rpx; 
  flex-shrink: 0;
}

/* 【新增】价格容器：确保价格和单位在一行，且右对齐 */
.price-box {
    display: flex; 
    align-items: baseline;
    color: #FA5151;
    width: 100%;
    justify-content: flex-end; 
    white-space: nowrap; /* 防止换行 */
}

.price {
  font-size: 36rpx;
  font-weight: bold;
}
.price-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
  color: #999;
}

.book-btn {
  background-color: #333;
  color: #fff;
  border-radius: 20rpx;
  padding: 0 10rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-top: 46rpx;
  width: 110rpx !important;
}
