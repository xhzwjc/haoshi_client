/* pages/index/index.wxss */
@import "/app.wxss";

.page-index {
  padding-bottom: 200rpx;
  background-color: var(--ios-bg-base);
  min-height: 100vh;
}

/* -- 1. Header Area (Integrated Glass) -- */
.glass-header-container {
  position: relative;
  margin-bottom: 40rpx;
}

.banner-container {
  width: 100%;
  height: 420rpx; /* Taller, more immersive */
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.4) 100%);
  pointer-events: none;
}

/* Notice Bar - Floating Glass Pill */
.notice-bar-glass {
  position: absolute;
  bottom: -32rpx; /* Float overlapping banner */
  left: 32rpx;
  right: 32rpx;
  height: 88rpx;
  background: var(--ios-bg-card-active); /* High opacity glass */
  backdrop-filter: var(--ios-blur-material);
  border-radius: 44rpx; /* Pill shape */
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  box-shadow: var(--ios-shadow-float);
  border: 1px solid rgba(255,255,255,0.6);
  z-index: 10;
}

.notice-icon-circle {
  width: 64rpx;
  height: 64rpx;
  background: var(--ios-tint-orange);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1); /* Make icon white */
}

.notice-scroll-wrap {
  flex: 1;
  overflow: hidden;
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  /* Optional: Fade mask for smoother enter/exit visual */
  mask-image: linear-gradient(to right, transparent 0%, black 20rpx, black calc(100% - 20rpx), transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 20rpx, black calc(100% - 20rpx), transparent 100%);
}

.notice-text {
  font-size: 28rpx;
  color: var(--ios-text-primary);
  white-space: nowrap;
  font-weight: 500;
  
  display: inline-block;
  padding-left: 100%; /* Start from right edge of container */
  animation: marquee 15s linear infinite;
}

@keyframes marquee {
  0% {
    transform: translate3d(0, 0, 0);
  }
  100% {
    transform: translate3d(-100%, 0, 0);
  }
}

/* -- 2. Sections Container -- */
.section-container {
  padding: 0 32rpx;
  margin-top: 64rpx; /* Space for floating elements */
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end; /* Align baseline */
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.section-title {
  font-size: 40rpx; /* iOS Heavy Title */
  font-weight: 800;
  color: var(--ios-text-primary);
  letter-spacing: -0.5px;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--ios-tint-blue);
  font-weight: 500;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
}

/* -- 3. Service Grid (Glass Tiles) -- */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--ios-bg-card);
  border-radius: var(--ios-radius-m);
  padding: 32rpx 0;
  /* No shadow on idle, clear structure */
  border: 1px solid rgba(255,255,255,0.4); 
}

.glass-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  /* background-color removed, using glass bg directly */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.more-icon-wrap {
  background: rgba(0,0,0,0.03); /* Subtle grey for 'more' */
  border-radius: 50%; 
}

.grid-icon {
  width: 56rpx;
  height: 56rpx;
}

.grid-text {
  font-size: 26rpx;
  color: var(--ios-text-primary);
  font-weight: 500;
}

/* -- 4. Recommendation List (Glass Cards) -- */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.service-glass-card {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: var(--ios-bg-card);
  backdrop-filter: var(--ios-blur-material);
  border-radius: var(--ios-radius-m);
  padding: 32rpx;
  box-shadow: var(--ios-shadow-card);
  border: 1px solid rgba(255,255,255,0.4);
}

.card-left {
  flex: 1;
  padding-right: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  letter-spacing: -0.5rpx;
}

.hot-tag {
  background: rgba(255, 59, 48, 0.1);
  color: var(--ios-tint-red);
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  font-weight: 700;
}

.card-desc {
  font-size: 26rpx;
  color: var(--ios-text-secondary);
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rating-box {
  display: flex;
  align-items: center;
}

.rating-star {
  color: var(--ios-tint-orange);
  font-size: 24rpx;
  margin-right: 8rpx;
}

.rating-text {
  font-weight: 700;
  color: var(--ios-text-primary);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.rating-count {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 140rpx;
}

.price-box {
  margin-bottom: 20rpx;
  text-align: right;
}

.book-btn-glass {
  background: var(--ios-tint-blue);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 30rpx; /* Pill button */
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3); /* Colored shadow */
}
