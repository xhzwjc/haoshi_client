/* pages/index/index.wxss */
@import "/app.wxss"; /* 引入全局样式 */

.page-index {
  padding-bottom: 120rpx; /* 留出tabbar空间 */
}

/* 1. 顶部Banner */
.banner-container {
  width: 100%;
  height: 256rpx;
  background: linear-gradient(180deg, #5A9BFF 0%, #409EFF 100%);
  padding: 32rpx;
  box-sizing: border-box;
}
.banner-content {
  padding-top: 40rpx;
  color: #fff;
}
.banner-title {
  font-size: 40rpx;
  font-weight: bold;
}
.banner-sub {
  font-size: 28rpx;
  margin-top: 16rpx;
  opacity: 0.9;
}

/* 2. 平台通知 */
.notification-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #FFFBE8;
  color: #ED6A0C;
  font-size: 26rpx;
  padding: 0 32rpx;
  margin: 0 32rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  position: relative;
  top: -40rpx; /* 关键：重叠在Banner上 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.noti-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

/* 3. 家政服务 Grid */
.service-section {
  padding: 0 32rpx;
  margin-top: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 32rpx;
  padding: 32rpx 16rpx;
  box-sizing: border-box;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 0;
}
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.grid-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.grid-icon {
  width: 52rpx;
  height: 52rpx;
}
.grid-text {
  font-size: 26rpx;
  color: #333;
}

/* 4. 热门推荐 */
.recommend-section {
  background: #fff;
  border-radius: 16rpx;
  margin: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
}
.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}
.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

/* 服务卡片 */
.service-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.service-card:last-child {
  border-bottom: none;
}
.card-left {
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.card-footer {
  font-size: 24rpx;
  color: #999;
}
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 32rpx;
}
.book-btn {
  background-color: #333;
  color: #fff;
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* 帮助按钮 */
.help-btn {
  position: fixed;
  right: 32rpx;
  bottom: 150rpx; /* 避开tabbar */
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}