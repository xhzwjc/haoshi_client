/* pages/order/order.wxss */
page {
  background-color: #F7F8FA;
}
.page-order {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 1. 顶部Tab */
.tabs-container {
  background-color: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}
.tabs {
  display: flex;
  align-items: center;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}
.tab-item.active {
  color: #333;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #409EFF;
  border-radius: 3rpx;
}

/* 2. 订单列表 */
.order-list-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 120rpx; /* 避开tabbar */
}
.order-card {
  background-color: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.service-name {
  font-size: 30rpx;
  font-weight: bold;
}
.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background-color: #f2f2f2;
}
.status-tag.status-completed { color: #999; background-color: #F7F8FA; }
.status-tag.status-pending { color: #409EFF; background-color: #ECF5FF; }
.status-tag.status-running { color: #FA5151; background-color: #FFF1F0; }
.status-tag.status-cancelled { color: #999; background-color: #F7F8FA; }

.order-no {
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}
.info-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.info-line:last-child {
  margin-bottom: 0;
}
.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}
.card-footer {
  border-top: 1rpx solid #F0F0F0;
  padding-top: 24rpx;
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.payment-info {
  font-size: 26rpx;
  color: #666;
}
.payment-info .price {
  font-size: 30rpx;
  color: #FA5151;
  font-weight: bold;
}
.card-actions {
  display: flex;
}
.btn {
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 12rpx !important;
  border-radius: 20rpx;
  margin-left: 16rpx;
  width: 150rpx !important;
}

.btn + .btn {
  margin-left: 5rpx;
}

.btn-plain {
  background-color: #fff;
  border: 1rpx solid #ccc;
  color: #333;
}
.btn-dark {
  background-color: #333;
  color: #fff;
  border: 1rpx solid #333;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

/* 帮助图标 */
.help-btn {
  position: fixed;
  right: 32rpx;
  bottom: 150rpx; /* 避开tabbar */
  width: 80rpx;
  height: 80rpx;
}