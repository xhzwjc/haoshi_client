/* pages/order/order.wxss */
page {
  background-color: #F7F8FA;
}
.page-order {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 1. 顶部Tab */
.tabs-container {
  background-color: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}
.tabs {
  display: flex;
  align-items: center;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}
.tab-item.active {
  color: #333;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #409EFF;
  border-radius: 3rpx;
}

/* 2. 订单列表 */
.order-list-scroll {
  flex: 1;
  height: 0;
  /* 【移除】padding-bottom */
}

/* 【新增】内部列表容器样式 */
.list-container {
  /* 将底部间距应用到这里 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.order-card {
  background-color: #fff;
  margin: 24rpx; /* 上下左右边距 */
  border-radius: 16rpx;
  padding: 32rpx;
  /* 新增：防止卡片内元素溢出 */
  overflow: hidden;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.service-name {
  font-size: 30rpx;
  font-weight: bold;
}
.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background-color: #f2f2f2;
}
/* 保留旧样式 */
.status-tag.status-completed { color: #999; background-color: #F7F8FA; }
.status-tag.status-pending { color: #409EFF; background-color: #ECF5FF; }
.status-tag.status-running { color: #FA5151; background-color: #FFF1F0; }
.status-tag.status-cancelled { color: #999; background-color: #F7F8FA; }

/* 【新增】 适配新状态码的颜色 */
.status-tag.status-10 { color: #409EFF; background-color: #ECF5FF; } /* 待接单 */
.status-tag.status-20 { color: #07C160; background-color: #F0FFF8; } /* 待服务 */
.status-tag.status-30 { color: #FA5151; background-color: #FFF1F0; } /* 服务中 */
.status-tag.status-35 { color: #ED6A0C; background-color: #FFFBE8; } /* 待确认金额 (警告色) */
.status-tag.status-40 { color: #FF5722; background-color: #FFF0EB; } /* 待支付 (强调色) */
.status-tag.status-50 { color: #409EFF; background-color: #ECF5FF; } /* 待评价 */
.status-tag.status-60 { color: #999; background-color: #F7F8FA; } /* 已完成 */
.status-tag.status-0 { color: #999; background-color: #F7F8FA; }  /* 已取消 */
.status-tag.status--1 { color: #999; background-color: #F7F8FA; } /* 已拒单 */

.order-no {
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}
.info-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.info-line:last-child {
  margin-bottom: 0;
}
.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

/* 【新增：备注信息样式】 */
.remark-box {
  background-color: #FFFBEB; /* 柔和的淡黄色 */
  border: 1rpx solid #FFECB3; /* 浅黄色边框 */
  color: #CC9A00; /* 略深的黄色字体 */
  font-size: 24rpx; /* 较小的字体 */
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 16rpx; /* 与上方信息行间隔 */
  margin-bottom: 16rpx; /* 与下方分隔线/其他信息行保持间距 */
  display: flex;
  line-height: 1.4;
  word-break: break-all;
}
.remark-label {
  font-weight: bold;
  flex-shrink: 0;
}
.remark-content {
  flex-grow: 1;
}

.card-footer {
  border-top: 1rpx solid #F0F0F0;
  padding-top: 24rpx;
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* 新增：按钮区域超出时自动换行，不顶出屏幕 */
  flex-wrap: wrap;
  gap: 12rpx 0; /* 换行后上下间距 */
}
.payment-info {
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.payment-info .price {
  font-size: 30rpx;
  color: #FA5151;
  font-weight: bold;
  margin-left: 6rpx;
}
.card-actions {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx; /* 按钮间距（最小化） */
  /* 新增：按钮太多时换行 */
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* 【核心强制修改：彻底自适应宽度】 */
.btn {
  /* 1. 覆盖原生button默认样式 */
  min-width: auto !important; /* 取消最小宽度限制（关键） */
  width: 160rpx !important;
  box-sizing: border-box !important; /* 确保padding不撑大宽度 */

  /* 2. 极致压缩内边距 */
  padding: 0 10rpx !important; /* 左右仅10rpx内边距（四字刚好） */
  margin: 0 !important; /* 彻底移除边距 */

  /* 3. 固定基础样式 */
  font-size: 24rpx !important; /* 略微缩小字体，进一步省空间 */
  height: 49rpx !important; /* 降低按钮高度，更紧凑 */
  line-height: 48rpx !important; /* 与高度一致，垂直居中 */
  border-radius: 24rpx !important; /* 对应高度的圆角 */
  white-space: nowrap !important; /* 文字不换行 */
  flex-shrink: 0 !important;
}

/* 覆盖小程序button默认边框和背景 */
.btn::after {
  border: none !important; /* 移除原生button的默认边框阴影 */
}

.btn-plain {
  background-color: #fff !important;
  border: 1rpx solid #ccc !important;
  color: #333 !important;
}
.btn-dark {
  background-color: #333 !important;
  color: #fff !important;
  border: 1rpx solid #333 !important;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.list-footer-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}