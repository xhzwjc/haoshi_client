<view class="page-order">
  <view class="tabs-container">
    <view class="tabs">
      <view
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="index"
        bindtap="onTabClick"
        data-index="{{index}}"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <scroll-view class="order-list-scroll" scroll-y>
    <block wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="order_no">
        <view class="card-header">
          <view class="service-name">{{item.service_name}}</view>
          <view class="status-tag status-{{item.status}}">{{item.status_text}}</view>
        </view>
        <view class="order-no">订单号: {{item.order_no}}</view>
        
        <view class="card-body">
          <view class="info-line" wx:if="{{item.address}}">
            <image class="info-icon" src="/images/icon_location_gray.png" mode="widthFix"></image>
            <text>{{item.address}}</text>
          </view>
          <view class="info-line" wx:if="{{item.service_time}}">
            <image class="info-icon" src="/images/icon_time_gray.png" mode="widthFix"></image>
            <text>{{item.service_time}}</text>
          </view>
          <view class="info-line" wx:if="{{item.master_info}}">
            <image class="info-icon" src="/images/icon_master_gray.png" mode="widthFix"></image>
            <text>{{item.master_info}}</text>
          </view>
        </view>

        <view class="card-footer">
          <view class="payment-info">
            实付: <text class="price">¥{{item.payment}}</text>
          </view>
          <view class="card-actions">
            <button class="btn btn-plain" wx:if="{{item.status === 'pending'}}">联系客服</button>
            <button class="btn btn-plain" wx:if="{{item.status === 'pending'}}">取消订单</button>
            
            <button class="btn btn-dark" wx:if="{{item.status === 'completed'}}">评价</button>
            
            <button class="btn btn-plain" wx:if="{{item.status !== 'running'}}">查看详情</button>
            <button class="btn btn-plain" wx:if="{{item.status === 'running'}}">查看详情</button>
          </view>
        </view>
      </view>
    </block>
    
    <view class="empty-state" wx:else>
      <image class="empty-icon" src="/images/icon_empty.png"></image>
      <text>暂无相关订单</text>
    </view>
  </scroll-view>

  <image class="help-btn" src="/images/icon_help.png"></image>
</view>