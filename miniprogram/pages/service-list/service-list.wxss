/* pages/service-list/service-list.wxss */
@import "/app.wxss";

.page-service-list {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA;
}

/* 1. 顶部搜索栏 */
.search-bar-wrap {
  background-color: #fff;
  padding: 16rpx 32rpx;
  flex-shrink: 0; /* 【关键】防止被 scroll-view 挤压 */
}
.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #F7F8FA;
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 2. 分类筛选Tab */
.filter-tabs-wrap {
  background-color: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0; /* 【关键】防止被 scroll-view 挤压 */
}
.filter-tabs {
  display: flex;
  align-items: center;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}
.tab-item.active {
  color: #333;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #409EFF;
  border-radius: 3rpx;
}

/* 3. 服务列表 【scroll-view 占据剩余空间】*/
.service-scroll-list {
  flex: 1;
  overflow-y: auto;
  /* height: 0; 关键：让scroll-view在flex布局中生效 */
}
.list-content {
  margin: 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 【新增】旋转动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 【修改】列表中央加载状态：带 Loading Spinner */
.loading-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 400rpx; /* 确保有足够高度展示 */
  font-size: 28rpx;
  color: #999;
}
.loading-spinner {
    width: 40rpx;
    height: 40rpx;
    border: 4rpx solid rgba(0, 0, 0, 0.1);
    border-left-color: #333; /* 旋转部分的颜色 */
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 20rpx;
}

/* 【新增】上拉加载更多/底部文案样式 */
.load-more-text {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30rpx 0;
    font-size: 26rpx;
    color: #999;
}
.load-more-text .loading-spinner {
    width: 28rpx;
    height: 28rpx;
    border-width: 3rpx;
    margin-right: 12rpx;
    margin-bottom: 0;
}

/* 【修改】空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}
.empty-state .empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

/* 服务卡片 (样式保持不变) */
.service-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.service-card:last-child {
  border-bottom: none;
}
.card-left {
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.hot-tag {
  font-size: 20rpx;
  color: #FA5151;
  border: 1rpx solid #FA5151;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.card-footer {
  font-size: 24rpx;
  color: #999;
}
.rating-box {
    display: flex;
    align-items: center;
}
.rating-star {
    color: #FFC000;
    margin-right: 8rpx;
}
.rating-text {
    color: #333;
    font-weight: bold;
    margin-right: 20rpx;
}
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 32rpx;
}
.price-box {
  display: flex;
  align-items: baseline;
  color: #FA5151;
}
.price {
  font-size: 36rpx;
  font-weight: bold;
}
.price-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
  color: #999;
}

.book-btn-list {
  background-color: #333;
  color: #fff;
  border-radius: 20rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-top: 46rpx;
  width: 200rpx !important;
}

/* 帮助按钮 */
.help-btn {
  position: fixed;
  right: 32rpx;
  bottom: 150rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}