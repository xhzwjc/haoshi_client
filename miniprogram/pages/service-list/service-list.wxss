/* pages/service-list/service-list.wxss */
@import "/app.wxss";

.page-service-list {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA;
}

/* 1. 顶部搜索栏 */
.search-bar-wrap {
  background-color: #fff;
  padding: 16rpx 32rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #F7F8FA;
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 2. 分类筛选Tab */
.filter-tabs-wrap {
  background-color: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}
.filter-tabs {
  display: flex;
  align-items: center;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}
.tab-item.active {
  color: #333;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #409EFF;
  border-radius: 3rpx;
}

/* 3. 服务列表 */
.service-scroll-list {
  flex: 1;
  overflow-y: auto;
  height: 0; /* 关键：让scroll-view在flex布局中生效 */
  padding-bottom: 120rpx; /* 避开tabbar */
}
.list-content {
  margin: 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 服务卡片 (复用 index.wxss 的样式) */
.service-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.service-card:last-child {
  border-bottom: none;
}
.card-left {
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.card-footer {
  font-size: 24rpx;
  color: #999;
}
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 32rpx;
}
.price-box {
  display: flex;
  align-items: baseline;
}
.book-btn-list {
  background-color: #333;
  color: #fff;
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* 帮助按钮 */
.help-btn {
  position: fixed;
  right: 32rpx;
  bottom: 150rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}