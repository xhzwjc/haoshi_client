/* /pages/order-detail/order-detail.wxss */

/* === 【新增】全屏居中加载状态样式 === */
.loading-state {
  position: fixed; /* 固定定位，覆盖全屏 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center; /* 垂直居中 */
  align-items: center; /* 水平居中 */
  /* 使用白色背景，更简洁美观，且覆盖页面内容 */
  background-color: #fff; 
  z-index: 9999; /* 确保在所有内容之上 */
  color: #999;
  font-size: 28rpx;
}

/* 加载动效 (Spinner) */
.loading-state::before {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e5e5e5; /* 灰色背景边框 */
  /* 使用主题色（或一个鲜明的颜色）作为旋转部分 */
  border-top-color: #1677FF; 
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite; /* 旋转动画 */
  margin-bottom: 20rpx; /* 与文字保持距离 */
}

/* 旋转动画定义 */
@keyframes loading-rotate {
  to {
    transform: rotate(360deg);
  }
}
/* ==================================== */


/* === 基础设置 === */
.page-order-detail {
  /* 适配安全区 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); 
  background-color: #f7f7f7;
  min-height: 100vh;
}

/* === 通用卡片样式 === */
.section-card {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 12rpx; 
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.03);
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.price-value {
  font-size: 36rpx;
  color: #FF5722;
}

/* === 订单状态卡片 === */
.status-card {
  background-color: #1677FF; /* 主题色背景 */
  color: #fff;
  padding: 60rpx 30rpx;
  margin: 0;
  border-radius: 0 0 20rpx 20rpx; /* 底部圆角 */
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}
.status-main {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}


/* === 信息列表样式 (通用) === */
.info-list {
  /* 继承卡片 padding */
}
.info-item {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f4f4f4; 
  align-items: center;
}
.info-item:last-child {
  border-bottom: none;
}
.label {
  color: #999;
  flex-shrink: 0;
  margin-right: 30rpx;
}
.value {
  color: #333;
  text-align: right;
  word-break: break-all;
  flex-grow: 1;
}
.value.long-text {
  max-width: 70%;
}

/* 费用明细特殊样式 */
.price-detail .total-row {
  margin-top: 15rpx;
  border-top: 1rpx dashed #eee;
  font-size: 32rpx;
  font-weight: bold;
}
.price-detail .total-label {
  color: #333;
}
.price-detail .total-price {
  color: #FF5722;
}

/* 订单编号复制按钮 */
.order-data .info-item {
  position: relative;
  padding-right: 120rpx; /* 留出复制按钮位置 */
}
.order-data .value {
  margin-right: 20rpx; /* 与复制按钮保持距离 */
}
.copy-btn {
  position: absolute;
  right: 0;
  color: #1677FF;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid #1677FF;
  border-radius: 8rpx;
  line-height: 1;
}

/* === 底部操作栏 === */
.bottom-bar.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end; /* 按钮靠右 */
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); /* 适配安全区 */
  background-color: #fff;
  box-shadow: 0 -2rpx 5rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
}
.action-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 10rpx;
  margin: 0;
  padding: 0;
}
.default-btn {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ccc;
}
.warn-btn {
  background-color: #fff;
  color: #FF5722;
  border: 1rpx solid #FF5722;
}
.primary-btn {
  background-color: #FF5722; /* 突出操作使用橙色 */
  color: #fff;
  border: none;
}

.order-timeline .timeline-list {
  position: relative;
  padding-left: 28rpx;
}

.order-timeline .timeline-list::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: 2rpx;
  background: #e5e5e5;
}

.order-timeline .timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.order-timeline .timeline-item:last-child {
  margin-bottom: 0;
}

.order-timeline .timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #1677FF;
  margin-right: 20rpx;
  margin-top: 2rpx;
}

.order-timeline .timeline-content {
  flex: 1;
}

.order-timeline .timeline-label {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.order-timeline .timeline-value {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.order-timeline .timeline-review {
  margin-top: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-timeline .review-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.order-timeline .review-block.reply {
  border-top: 1rpx dashed #e4e7ec;
  padding-top: 16rpx;
  margin-top: 6rpx;
}

.order-timeline .review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-timeline .review-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.order-timeline .review-rating {
  font-size: 24rpx;
  color: #ff9f0a;
}

.order-timeline .review-time {
  font-size: 22rpx;
  color: #999;
}

.order-timeline .review-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  word-break: break-word;
}

/* ============= 修复师傅电话“拨打”按钮顶出去问题 ============= */
/* 电话专属行布局 */
.phone-item {
  align-items: center;
  padding: 20rpx 0; /* 上下稍放大一点点击区域 */
}

.phone-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx; /* 号码和按钮之间的间距 */
  min-width: 0; /* 关键！允许内部元素被压缩 */
}

.phone-number {
  color: #333;
  font-size: 28rpx;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}

.call-btn {
  margin: 0;
  padding: 0 16rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 32rpx;
  flex-shrink: 0;
  width: 100rpx !important;      
  min-width: auto !important;
  max-width: 100rpx !important;
}

.call-btn::after { border: none; }

.call-btn::after { border: none; }

.call-btn::after {
  border: none;
}

.call-btn:hover {
  opacity: 0.8;
}

/* 可选：高亮绿色风格（微信常用） */
.call-btn.primary {
  background: #07c160;
  color: #fff;
}

