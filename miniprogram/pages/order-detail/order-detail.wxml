<view class="page-order-detail">
    <block wx:if="{{loading}}">
        <view class="loading-state">
            <text>订单加载中...</text>
        </view>
    </block>

    <block wx:else>
        <view class="status-card">
            <view class="status-main">{{orderDetail.status_text}}</view>
            <view class="status-tip">{{orderDetail.status_tip}}</view>
        </view>

        <view class="section-card service-info">
            <view class="section-title">
                <text>{{orderDetail.service_name || '服务名称'}}</text>
                
                <text class="price-value">
                    <block wx:if="{{orderDetail.is_final_price}}">
                        <text>实付: ¥{{orderDetail.price_display}}</text>
                    </block>
                    <block wx:else>
                        <text>价格范围: ¥{{orderDetail.price_display}}</text>
                    </block>
                </text>
            </view>
            <view class="info-list">
                <view class="info-item">
                    <text class="label">服务时间</text>
                    <text class="value">{{orderDetail.service_date}} {{orderDetail.service_time_slot}}</text>
                </view>
                <view class="info-item">
                    <text class="label">服务地址</text>
                    <text class="value long-text">{{orderDetail.address}}</text>
                </view>
                <view class="info-item">
                    <text class="label">联系人</text>
                    <text class="value">{{orderDetail.contact_name}}</text>
                </view>
                <view class="info-item">
                    <text class="label">联系电话</text>
                    <text class="value">{{orderDetail.contact_phone}}</text>
                </view>
            </view>
        </view>
        
        <view class="section-card master-info" wx:if="{{orderDetail.status >= 20}}">
            <view class="section-title">师傅信息</view>
            <view class="info-list">
                <view class="info-item">
                    <text class="label">师傅姓名</text>
                    <text class="value">{{orderDetail.master_info || '等待分配'}}</text>
                </view>
                <view class="info-item" wx:if="{{orderDetail.master_phone}}">
                    <text class="label">联系电话</text>
                    <text class="value">{{orderDetail.master_phone}}</text>
                    <text class="copy-btn" bindtap="handleAction" data-action="联系师傅">拨打</text> 
                </view>
            </view>
        </view>

        <view class="section-card price-detail" wx:if="{{orderDetail.is_final_price}}">
            <view class="section-title">费用明细</view>
            <view class="info-list">
                <view class="info-item">
                    <text class="label">服务费</text>
                    <text class="value">¥{{orderDetail.price_display}}</text>
                </view>
                <view class="info-item total-fee">
                    <text class="label">合计应付</text>
                    <text class="value total-price">¥{{orderDetail.price_display}}</text>
                </view>
            </view>
        </view>

        <view class="section-card order-timeline" wx:if="{{orderDetail.timeline && orderDetail.timeline.length}}">
            <view class="section-title">订单进度</view>
            <view class="timeline-list">
                <view class="timeline-item" wx:for="{{orderDetail.timeline}}" wx:key="{{item.label}}-{{index}}">
                    <view class="timeline-dot"></view>
                    <view class="timeline-content">
                        <text class="timeline-label">{{item.label}}</text>
                        <text class="timeline-value">{{item.value}}</text>
                        <view class="timeline-review" wx:if="{{item.comment || item.reply}}">
                            <view class="review-block" wx:if="{{item.comment}}">
                                <view class="review-header">
                                    <text class="review-title">客户评价</text>
                                    <text class="review-rating" wx:if="{{item.rating !== undefined && item.rating !== ''}}">评分：{{item.rating}}分</text>
                                </view>
                                <text class="review-content">{{item.comment}}</text>
                            </view>
                            <view class="review-block reply" wx:if="{{item.reply}}">
                                <view class="review-header">
                                    <text class="review-title">师傅回复</text>
                                    <text class="review-time" wx:if="{{item.reply_at}}">{{item.reply_at}}</text>
                                </view>
                                <text class="review-content">{{item.reply}}</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>

        <view class="section-card order-data">
            <view class="section-title">订单信息</view>
            <view class="info-list">
                <view class="info-item">
                    <text class="label">订单编号</text>
                    <text class="value">{{orderDetail._id}}</text>
                    <text class="copy-btn" data-content="{{orderDetail._id}}" bindtap="copyContent">复制</text>
                </view>
                <view class="info-item">
                    <text class="label">下单时间</text>
                    <text class="value">{{orderDetail.created_at_fmt}}</text>
                </view>
                <view class="info-item">
                    <text class="label">备注信息</text>
                    <text class="value long-text">{{orderDetail.remarks || '无'}}</text>
                </view>
            </view>
        </view>
    </block>
    
    <view class="bottom-bar action-bar" wx:if="{{!loading}}">
        <block wx:for="{{actions}}" wx:key="text">
            <button
                class="action-btn {{item.type === 'primary' ? 'primary-btn' : (item.type === 'warn' ? 'warn-btn' : 'default-btn')}}"
                data-action="{{item.text}}"
                bindtap="handleAction"
            >
                {{item.text}}
            </button>
        </block>
    </view>
</view>