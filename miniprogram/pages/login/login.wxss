page {
  background: #101c2f;
}

.login-page {
  position: relative;
  min-height: 100vh;
  padding: 160rpx 48rpx 120rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  box-sizing: border-box;
  overflow: hidden;
}

.bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #0f1f3a 0%, #1e3a8a 45%, #2d6a4f 100%);
  opacity: 0.94;
  z-index: 0;
}

.floating-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(6rpx);
  z-index: 0;
  opacity: 0.45;
}

.circle-one {
  width: 420rpx;
  height: 420rpx;
  top: 60rpx;
  right: -160rpx;
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.45) 0%, rgba(59, 130, 246, 0) 70%);
}

.circle-two {
  width: 360rpx;
  height: 360rpx;
  bottom: -140rpx;
  left: -120rpx;
  background: radial-gradient(circle at center, rgba(16, 185, 129, 0.4) 0%, rgba(16, 185, 129, 0) 70%);
}

.brand-section {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 36rpx;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.25);
  background: rgba(255, 255, 255, 0.12);
}

.brand-text {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 58rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-slogan {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.78);
}

.login-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  padding: 56rpx 44rpx;
  box-shadow: 0 36rpx 80rpx rgba(11, 24, 53, 0.35);
  backdrop-filter: blur(30rpx);
}

.card-head {
  margin-bottom: 48rpx;
}

.card-title {
  font-size: 46rpx;
  color: #0f223f;
  font-weight: 600;
}

.card-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6c7a92;
}

.role-options {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.role-option {
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid transparent;
  box-shadow: 0 18rpx 42rpx rgba(15, 34, 67, 0.12);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

.role-option:active {
  transform: translateY(4rpx);
}

.role-option.active {
  transform: translateY(-6rpx);
  border-color: rgba(37, 99, 235, 0.38);
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
  box-shadow: 0 24rpx 50rpx rgba(37, 99, 235, 0.18);
}

.role-option.client .option-icon {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(59, 130, 246, 0.08));
}

.role-option.technician .option-icon {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(16, 185, 129, 0.08));
}

.option-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
}

.option-icon image {
  width: 60rpx;
  height: 60rpx;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-title {
  font-size: 36rpx;
  color: #0f223f;
  font-weight: 600;
}

.option-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b768c;
  line-height: 1.6;
}

.option-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

.card-footer {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: rgba(15, 34, 67, 0.55);
  text-align: center;
  line-height: 1.6;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 17, 32, 0.65);
  backdrop-filter: blur(8rpx);
  z-index: 1000;
}

.login-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 32rpx 80rpx rgba(15, 24, 53, 0.25);
  overflow: hidden;
  z-index: 1001;
}

.modal-title {
  text-align: center;
  padding: 40rpx 20rpx 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f223f;
}

.modal-body {
  padding: 10rpx 56rpx 30rpx;
}

.input-group {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f3f6;
}

.input-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #5c6b7a;
}

.modal-body input {
  flex: 1;
  height: 72rpx;
  font-size: 32rpx;
  color: #1f2d3d;
}

.input-placeholder {
  color: #b8c2cc;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eef1f5;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
}

.cancel-btn {
  color: #7a8599;
  border-right: 1rpx solid #eef1f5;
}

.confirm-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
}
