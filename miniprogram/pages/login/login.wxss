page {
  background: #f5f7fb;
  min-height: 100vh;
  color: #1f2933;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.light-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(93, 135, 255, 0.12) 0%, rgba(255, 255, 255, 0.86) 45%, #f5f7fb 100%);
  z-index: 0;
}

.login-container {
  position: relative;
  z-index: 1;
  padding: 120rpx 48rpx 100rpx;
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(71, 122, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: #4a6cf0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1f2933;
}

.brand-subtitle {
  font-size: 28rpx;
  color: rgba(31, 41, 51, 0.6);
}

.headline {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.headline-main {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f2933;
}

.headline-sub {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(31, 41, 51, 0.6);
}

.role-panel {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.role-card {
  position: relative;
  padding: 44rpx 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(74, 108, 240, 0.08);
  box-shadow: 0 24rpx 60rpx rgba(32, 59, 126, 0.08);
  transition: all 0.2s ease;
}

.role-card.active {
  border-color: rgba(74, 108, 240, 0.45);
  box-shadow: 0 30rpx 80rpx rgba(74, 108, 240, 0.16);
}

.role-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1f2933;
}

.role-desc {
  font-size: 28rpx;
  color: rgba(31, 41, 51, 0.6);
  line-height: 1.6;
  margin-right: 64rpx;
}

.role-arrow {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 44rpx;
  color: rgba(74, 108, 240, 0.5);
}

.statement {
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.58);
  line-height: 1.7;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.28);
  backdrop-filter: blur(6px);
  z-index: 10;
}

.login-modal {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 11;
  padding: 0 48rpx;
}

.modal-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 40rpx 90rpx rgba(17, 25, 40, 0.18);
}

.modal-header {
  margin-bottom: 36rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2933;
}

.modal-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.55);
  line-height: 1.5;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-label {
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.7);
}

input {
  background: #f3f6fd;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #1f2933;
  border: 1rpx solid rgba(74, 108, 240, 0.16);
  font-size: 28rpx;
}

.input-placeholder {
  color: rgba(74, 108, 240, 0.55);
}

.auth-tip {
  background: rgba(74, 108, 240, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
}

.method-switch {
  display: flex;
  gap: 24rpx;
}

.method-pill {
  flex: 1;
  background: #f5f7fb;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(74, 108, 240, 0.14);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.method-pill.active {
  background: rgba(74, 108, 240, 0.12);
  border-color: rgba(74, 108, 240, 0.5);
  box-shadow: 0 12rpx 24rpx rgba(74, 108, 240, 0.16);
}

.method-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2933;
}

.method-desc {
  font-size: 22rpx;
  color: rgba(31, 41, 51, 0.5);
}

.method-pill.active .method-title {
  color: #3f5ce4;
}

.method-pill.active .method-desc {
  color: rgba(63, 92, 228, 0.9);
}

.auth-tip-text {
  font-size: 26rpx;
  color: rgba(31, 41, 51, 0.75);
  line-height: 1.7;
}

.auth-button {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4a6cf0 0%, #4d8dff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.auth-button[disabled] {
  opacity: 0.72;
}

.privacy-hint {
  font-size: 22rpx;
  color: rgba(31, 41, 51, 0.45);
  text-align: center;
}

.modal-actions {
  display: flex;
  margin-top: 24rpx;
}

.modal-actions.center {
  justify-content: center;
}

.modal-actions.align-end {
  justify-content: flex-end;
  gap: 24rpx;
}

.modal-btn {
  min-width: 160rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.modal-btn.ghost {
  background: #f5f7fb;
  color: rgba(31, 41, 51, 0.65);
  border: 1rpx solid rgba(74, 108, 240, 0.16);
}

.modal-btn.primary {
  background: #4a6cf0;
  color: #ffffff;
}

.modal-btn:active {
  opacity: 0.85;
}
