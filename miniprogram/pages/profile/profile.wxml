<view class="page-profile">
  <view class="profile-header">
    <view class="status-bar" style="height: {{statusBarHeight}}px"></view>
    <view class="title-bar" style="height: {{titleBarHeight}}px">我的</view>
    
    <view class="user-info-container">
      <view class="user-info">
        <image class="avatar" src="{{userInfo.avatar || '/packageCommon/images/default_avatar.png'}}"></image>
        <view class="user-details">
          <view class="user-name">{{userInfo.name || '用户001'}}</view>
          <view class="user-phone">{{userInfo.phone || '***********'}}</view>
        </view>
      </view>
      <view class="edit-btn" bindtap="onEditProfile">
        编辑资料 <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right_white.png" mode="widthFix"></image>
      </view>
    </view>

    <view class="stats-bar single">
      <view class="history-card">
        <view class="card-header">
          <text class="card-title">历史订单</text>
          <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right_white.png" mode="widthFix"></image>
        </view>
        <view class="card-body">
          <text class="count">{{userInfo.historyOrders || 0}}</text>
          <text class="unit">单</text>
        </view>
        <view class="card-desc">已完成 {{userInfo.completedOrders || 0}} 单</view>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goToPersonalInfo">
      <view class="menu-left">
        <image class="menu-icon" src="/packageCommon/images/icon_profile_user.png"></image>
        <text class="menu-label">个人信息</text>
      </view>
      <view class="menu-right">
        <text class="menu-desc">编辑资料</text>
        <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right.png" mode="widthFix"></image>
      </view>
    </view>
    <view class="menu-item" bindtap="goToAddressManage">
      <view class="menu-left">
        <image class="menu-icon" src="/packageCommon/images/icon_profile_location.png"></image>
        <text class="menu-label">地址管理</text>
      </view>
      <view class="menu-right">
        <text class="menu-desc">保存常用地址</text>
        <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right.png" mode="widthFix"></image>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="group-title">帮助与反馈</view>
    <view class="menu-item-view" bindtap="contactCustomerService">
      <view class="menu-left">
        <image class="menu-icon" src="/packageCommon/images/icon_master_gray.png"></image>
        <text class="menu-label">联系客服</text>
      </view>
      <view class="menu-right">
        <text class="menu-desc">400-123-4567</text>
        <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right.png" mode="widthFix"></image>
      </view>
    </view>
    <view class="menu-item-view" bindtap="submitFeedback">
      <view class="menu-left">
        <image class="menu-icon" src="/packageCommon/images/icon_profile_feedback.png"></image>
        <text class="menu-label">意见反馈</text>
      </view>
      <view class="menu-right">
        <text class="menu-desc">帮助我们改进</text>
        <image class="arrow-icon" src="/packageCommon/images/icon_arrow_right.png" mode="widthFix"></image>
      </view>
    </view>
  </view>

  <view class="settings-btn-container">
    <button class="settings-btn" bindtap="goToSettings">设置</button>
  </view>

</view>