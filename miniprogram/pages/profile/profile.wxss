/* pages/profile/profile.wxss */
page {
  background-color: #F7F8FA;
}
.page-profile {
  padding-bottom: 60rpx;
}

/* 1. 顶部 */
.profile-header {
  background: linear-gradient(180deg, #5A9BFF 0%, #409EFF 100%);
  color: #fff;
  padding: 0 32rpx;
  padding-bottom: 32rpx;
  margin-bottom: 96rpx; /* 为统计栏留出重叠空间 */
}
.title-bar {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 44px; /* 默认胶囊高度 */
}
.user-info-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
}
.user-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-right: 24rpx;
}
.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.user-phone {
  font-size: 28rpx;
  opacity: 0.8;
}
.edit-btn {
  font-size: 26rpx;
  opacity: 0.9;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
}
.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

/* 2. 统计栏 */
.stats-bar {
  position: relative;
  top: 32rpx;
  margin: 0 24rpx;
}

.stats-bar.single {
  background: transparent;
  box-shadow: none;
  padding: 0;
}

.history-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.08) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 28rpx;
  padding: 36rpx;
  backdrop-filter: blur(10px);
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-card .card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
}

.history-card .card-body {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.history-card .count {
  font-size: 58rpx;
  font-weight: 700;
}

.history-card .unit {
  font-size: 28rpx;
  opacity: 0.85;
}

.history-card .card-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 3. & 4. 菜单组 */
.menu-group {
  background-color: #fff;
  margin: 32rpx;
  border-radius: 16rpx;
  padding: 0 32rpx;
}
.group-title {
  font-size: 26rpx;
  color: #999;
  padding: 32rpx 0;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 112rpx;
  border-bottom: 1rpx solid #F0F0F0;
  background-color: #fff; /* 覆盖button默认样式 */
  line-height: normal; /* 覆盖button默认样式 */
  padding: 0; /* 覆盖button默认样式 */
  border-radius: 0; /* 覆盖button默认样式 */
}
.menu-item::after {
  border: none; /* 覆盖button默认边框 */
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-left {
  display: flex;
  align-items: center;
}
.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
}
.menu-label {
  font-size: 28rpx;
  color: #333;
}
.menu-right {
  display: flex;
  align-items: center;
}
.menu-desc {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

/* 5. 设置按钮 */
.settings-btn-container {
  margin: 32rpx;
}
.settings-btn {
  background-color: #fff;
  color: #333;
  font-size: 28rpx;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 10rpx 24rpx rgba(31,45,61,0.08);
  display: block;
  text-align: center;
  padding: 0;
}

.settings-btn::after {
  display: none;
}


/* 添加菜单项view样式 */
.menu-item-view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 112rpx;
  border-bottom: 1rpx solid #F0F0F0;
  background-color: #fff;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  /* 添加点击效果 */
  touch-action: manipulation;
}