/* components/order-detail-modal/order-detail-modal.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal-container {
  background-color: #fff;
  border-radius: 20rpx;
  width: 85%;
  max-width: 600rpx;
  overflow: hidden;
}
.modal-header {
  position: relative;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.close-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}
.modal-body {
  padding: 30rpx 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start; /* Align items top for long text */
  margin-bottom: 25rpx;
  font-size: 28rpx;
}
.detail-item:last-child { margin-bottom: 0; }
.label { color: #999; flex-shrink: 0; margin-right: 30rpx; }
.value { color: #333; text-align: right; word-break: break-all; }
.value.primary { font-weight: bold; }
.value.price { color: #FF5722; font-weight: bold; font-size: 32rpx;}
.value.placeholder { color: #ccc; }

/* 新增：地址行带导航按钮布局 */
.value-with-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  gap: 16rpx;
}

.value-with-action .value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

/* 新增：导航按钮样式 */
.btn-navigate {
  padding: 8rpx 24rpx !important;
  height: auto !important;
  line-height: 1.5 !important;
  font-size: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 8rpx;
  border: none;
  flex-shrink: 0;
}

.btn-navigate::after {
  border: none;
}


.remark-item { align-items: flex-start; } /* Override default alignment */
.remark-box {
    background-color: #FFFBEB;
    border: 1rpx solid #FFECB3;
    color: #CC9A00;
    font-size: 26rpx;
    padding: 12rpx 16rpx;
    border-radius: 8rpx;
    flex-grow: 1; /* Allow box to take space */
    text-align: left;
}
.fee-item { align-items: center; } /* Align price vertically */

.timeline-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.timeline-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.timeline-list {
  position: relative;
  padding-left: 20rpx;
}

.timeline-list::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: 2rpx;
  background: #e5e5e5;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #1677FF;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.timeline-content {
  flex: 1;
}

.timeline-label {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.timeline-value {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.modal-footer {
  display: flex;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
}
.modal-footer .btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx; /* 确保行高与高度完全一致 */
  font-size: 30rpx;
  border-radius: 40rpx;
  margin: 0;
  padding: 0; /* 清除默认内边距 */
  vertical-align: middle; /* 强制垂直居中对齐 */
  display: inline-flex; /* 用flex布局居中文字（更可靠） */
  align-items: center; /* 垂直居中 */
  justify-content: center; /* 水平居中 */
}
.btn-plain { background: #f0f0f0; color: #333; border: none; }
.btn-dark { background: #333; color: #fff; border: none; }
.btn.full-width { flex: 1 1 100%; } /* Make close button full width */