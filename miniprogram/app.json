{
  "pages": [
    "pages/login/login",
    "pages/index/index",
    "pages/service-list/service-list",
    "pages/order/order",
    "pages/profile/profile",
    "pages/order-detail/order-detail"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "家政服务",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#333333",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/packageCommon/images/tab_home.png",
        "selectedIconPath": "/packageCommon/images/tab_home_active.png"
      },
      {
        "pagePath": "pages/service-list/service-list",
        "text": "服务",
        "iconPath": "/packageCommon/images/tab_service.png",
        "selectedIconPath": "/packageCommon/images/tab_service_active.png"
      },
      {
        "pagePath": "pages/order/order",
        "text": "订单",
        "iconPath": "/packageCommon/images/tab_order.png",
        "selectedIconPath": "/packageCommon/images/tab_order_active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "/packageCommon/images/tab_profile.png",
        "selectedIconPath": "/packageCommon/images/tab_profile_active.png"
      }
    ]
  },
  "subpackages": [
    {
      "root": "subpackages/packageService",
      "pages": [
        "pages/booking/booking",
        "pages/select-time/select-time",
        "pages/confirm-pay/confirm-pay"
      ]
    },
    {
      "root": "subpackages/packageTech",
      "pages": [
        "pages/technician-index/technician-index",
        "pages/technician-orders/technician-orders",
        "pages/technician-detail/technician-detail",
        "pages/quote-order/quote-order",
        "pages/income/income",
        "pages/ratings/ratings",
        "pages/schedule/schedule"
      ]
    },
    {
      "root": "subpackages/packageOrder",
      "pages": [
        "pages/after-sale/after-sale",
        "pages/rate-order/rate-order"
      ]
    },
    {
      "root": "subpackages/packageProfile",
      "pages": [
        "pages/personal-info/personal-info",
        "pages/settings/settings",
        "pages/feedback/feedback",
        "pages/address-list/address-list"
      ]
    },
    {
      "root": "subpackages/packageAdmin",
      "pages": [
        "pages/admin-dashboard/admin-dashboard",
        "pages/admin-user-list/admin-user-list",
        "pages/admin-personnel-audit/admin-personnel-audit",
        "pages/admin-order-list/admin-order-list",
        "pages/admin-service-list/admin-service-list",
        "pages/admin-service-edit/admin-service-edit"
      ]
    }
  ],
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "用于选择服务地址并提供上门服务"
    }
  },
  "requiredPrivateInfos": [
    "chooseLocation"
  ]
}